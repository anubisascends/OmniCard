<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OmniCard.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <!-- Linux native libSkiaSharp (the SkiaSharp package only ships Windows/macOS natives). The
         NoDependencies build needs no fontconfig; the imaging pipeline never renders text. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <!-- TIFF decoding (scanner output); SkiaSharp has no TIFF codec. Pure managed, BSD licensed. -->
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OmniCard.Shared\OmniCard.Shared.csproj" />
  </ItemGroup>
  <!-- Tesseract language data. Copied to output (and flows to consuming apps) so the
       engine can load it at runtime; Apache-2.0, redistributable. tessdata_fast/eng. -->
  <ItemGroup>
    <None Include="tessdata\**\*.traineddata">
      <Link>tessdata\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- Reference crops of the MTG Planeswalker "hand" glyph that The List (plst) reprints
       print in the bottom-left collector block. Embedded so the detector can pHash-match
       them at runtime with no external asset dir. See OcrMatchingService.DetectMtgListSymbol. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\mtg-list-glyph-*.png" />
  </ItemGroup>
</Project>
