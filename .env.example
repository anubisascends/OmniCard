# Copy to .env and adjust. docker compose reads it automatically; never commit the real .env.
# Avoid ';', quotes and '$' in passwords (they break the connection string / compose interpolation).

# --- SQL Server ------------------------------------------------------------------------------
# SA password: at least 8 characters with three of upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=Change-Me-0mniCard
# Edition: Express (free, 10 GB per database), Developer (free, non-production), Standard, Enterprise.
MSSQL_PID=Express

# --- OmniCard web app ------------------------------------------------------------------------
# Host port the app is published on (http://<host>:8080/app/).
OMNICARD_HTTP_PORT=8080
# Version stamped into the image / shown in About (the build has no git history to derive it from).
OMNICARD_VERSION=0.0.0

# Unified store; the per-game catalog databases reuse it with the database name swapped.
# The app logs in as sa because it creates its databases on first start (needs dbcreator).
ConnectionStrings__OmniCard=Server=mssql,1433;Database=OmniCard;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True

# Data directory inside the container (mounted from the omnicard-data volume — keep /data).
DataDirectory=/data
# Rolling log files in /data/logs (also on `docker compose logs`).
Logging__File__Enabled=true
# Level of EF Core's per-command SQL logging (Information logs every query).
EF_SQL_LOG_LEVEL=Warning
# Level of ASP.NET Core's per-request logging (Information logs every request, health checks included).
ASPNETCORE_LOG_LEVEL=Warning

# Set to true when a reverse proxy (nginx, Caddy, Traefik) terminates HTTPS in front of the app,
# so the app sees the public scheme/host (cookies, eBay callback, MCP OAuth URLs).
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false

# The MCP endpoint (/mcp) only answers loopback requests unless OAuth is configured; inside a
# container nothing is loopback. Only set true if you put your own authentication in front of /mcp.
Mcp__AllowRemote=false

# Container time zone (logs, "Generated" timestamps in PDFs).
TZ=Etc/UTC

# --- eBay (optional) — leave blank to keep eBay disabled ---------------------------------------
eBay__AppId=
eBay__CertId=
eBay__DevId=
eBay__RuName=
# https://<public host>/api/ebay/callback — must match the RuName's "Auth accepted URL".
eBay__AcceptUrl=
# sandbox | production
eBay__Environment=sandbox
