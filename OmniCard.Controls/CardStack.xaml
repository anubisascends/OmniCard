<UserControl x:Class="OmniCard.Controls.CardStack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OmniCard.Controls"
             xmlns:conv="clr-namespace:OmniCard.Controls.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">

    <!-- A vertical pile of cards shown as thin title bars. Hovering a single card grows it to full
         size (code-behind animates that card's slot height); because the items sit in a StackPanel,
         the cards below it slide down to make room, à la Archidekt / the reference app. -->
    <ItemsControl x:Name="Items" ItemsSource="{Binding ItemsSource, ElementName=Root}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- Slot: collapsed to a thin title strip; expands on hover (code-behind). -->
                <Border x:Name="Slot"
                        Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:CardStack}}}"
                        Margin="0,0,0,2"
                        CornerRadius="6"
                        ClipToBounds="True"
                        Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                        Cursor="Hand"
                        MouseEnter="Slot_MouseEnter"
                        MouseLeave="Slot_MouseLeave"
                        PreviewMouseLeftButtonDown="Slot_PreviewMouseLeftButtonDown"
                        PreviewMouseRightButtonDown="Slot_PreviewMouseRightButtonDown">
                    <!-- Collapsed to a 34px title strip, EXCEPT the last card in the pile, which stays
                         full height so the stack has a visible bottom card. -->
                    <Border.Height>
                        <MultiBinding Converter="{conv:LastCardHeightConverter}" ConverterParameter="34">
                            <Binding/>
                            <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType={x:Type local:CardStack}}"/>
                            <Binding Path="CardHeight" RelativeSource="{RelativeSource AncestorType={x:Type local:CardStack}}"/>
                            <Binding Path="IsSelected"/>
                        </MultiBinding>
                    </Border.Height>
                    <Border.ToolTip>
                        <ToolTip MaxWidth="340"
                                 Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                 BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                                 BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}">
                                    <Run Text="{Binding SetName, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding SetCode, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                                           Text="{Binding TypeLine}"
                                           Visibility="{Binding TypeLine, Converter={conv:StringToVisibilityConverter}}"/>
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                    <Run Text="Condition: "/><Run Text="{Binding Condition, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Foil" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                           Visibility="{Binding IsFoil, Converter={conv:BoolToVisibilityConverter}}"/>
                                <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                    <Run Text="Market: "/><Run Text="{Binding MarketPrice, Converter={conv:MarketPriceDisplayConverter}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                    <Run Text="Quantity: "/><Run Text="{Binding Quantity, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>

                    <Grid VerticalAlignment="Top">
                        <!-- Placeholder card name for cards with no resolved art. -->
                        <TextBlock Text="{Binding Name}" Margin="8,7,8,0" VerticalAlignment="Top"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                                   Visibility="{Binding Source, ElementName=StackImage, Converter={conv:NullToVisibleConverter}}"/>

                        <!-- Card art at full size (explicit W×H), top-aligned so the collapsed slot
                             clips it to the card's name band. Stretch=Fill because W:H already match
                             the card aspect — Uniform would shrink it to the clipped 34px height. -->
                        <Image x:Name="StackImage"
                               Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:CardStack}}}"
                               Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType={x:Type local:CardStack}}}"
                               VerticalAlignment="Top"
                               Stretch="Fill"
                               local:TileArt.Card="{Binding}"
                               local:TileArt.DataDirectory="{Binding DataDirectory, RelativeSource={RelativeSource AncestorType={x:Type local:CardStack}}}"/>

                        <!-- Tag indicator -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                Margin="4" Padding="4,1" CornerRadius="3"
                                Background="#00000099"
                                Visibility="{Binding HasTags, Converter={conv:BoolToVisibilityConverter}}"
                                ToolTip="{Binding TagsDisplay}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Tag" Width="11" Height="11" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Tags.Count}" FontSize="9" FontWeight="Bold"
                                           Foreground="White" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Selection highlight overlay -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
