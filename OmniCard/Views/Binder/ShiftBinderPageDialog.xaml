<Window x:Class="OmniCard.Views.Binder.ShiftBinderPageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmniCard.Views.Binder"
        ShowInTaskbar="False"
        Title="Shift Cards" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{StaticResource AppFont}">
    <StackPanel Margin="16" MinWidth="360">
        <TextBlock Text="{Binding HeaderLabel}" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        <TextBlock TextWrapping="Wrap" MaxWidth="330" Margin="0,0,0,12"
                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                   Text="Move cards to correct an off-by-a-page data-entry mistake. Each card keeps its slot within the page; cards in the Unplaced pool aren't touched."/>

        <TextBlock Text="Direction" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        <RadioButton GroupName="Direction" Content="Toward the front (left / lower page numbers)"
                     IsChecked="{Binding ShiftLeft}" Margin="0,4,0,0"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        <RadioButton GroupName="Direction" Content="Toward the back (right / higher page numbers)" Margin="0,2,0,12"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

        <TextBlock Text="Which pages" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        <RadioButton GroupName="Scope" Content="Only this page"
                     IsChecked="{Binding ScopeOnlyThisPage}" Margin="0,4,0,0"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        <RadioButton GroupName="Scope" Content="This page and all pages before it"
                     IsChecked="{Binding ScopeThisAndBefore}" Margin="0,2,0,0"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        <RadioButton GroupName="Scope" Content="This page and all pages after it"
                     IsChecked="{Binding ScopeThisAndAfter}" Margin="0,2,0,12"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Pages to shift:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBox Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}"
                     Width="60" VerticalAlignment="Center"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="72" Margin="0,0,8,0" Padding="16,6"/>
            <Button Content="Shift" IsDefault="True" MinWidth="72" Padding="16,6" FontWeight="SemiBold" Click="OnShift"/>
        </StackPanel>
    </StackPanel>
</Window>
