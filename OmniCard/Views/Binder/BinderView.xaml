<Window x:Class="OmniCard.Views.Binder.BinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OmniCard.Views.Binder"
             xmlns:helpers="clr-namespace:OmniCard.Controls;assembly=OmniCard.Controls"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
             ShowInTaskbar="False"
             WindowStartupLocation="CenterOwner"
             WindowState="Maximized"
             Title="{Binding ContainerName, StringFormat='Binder — {0}'}"
             Height="900" Width="1400"
             Background="{DynamicResource MaterialDesign.Brush.Background}"
             TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Root/CardTileTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared right-click menu — full parity with the main Collection card list's context
                 menu (CardListView.xaml). Used by the Unplaced Cards pane and both binder-slot
                 pages; whichever surface was right-clicked first calls BinderViewModel.
                 SetSelectionSource so every command below acts on that surface's selection.
                 DataContext reaches back up to BinderViewModel via PlacementTarget, since Popups
                 don't inherit DataContext from the visual tree they're anchored to. -->
            <!-- x:Shared="False": this same key is applied via StaticResource to three separate
                 owners below (the Unplaced ListBox, and the left/right page ItemsControls) — a
                 ContextMenu instance can only have one logical parent, so each reference needs its
                 own freshly-instantiated copy rather than sharing one FrameworkElement instance. -->
            <ContextMenu x:Key="BinderCardContextMenu" x:Shared="False"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <!-- Slot-only: add a card straight into this page/slot (swap if occupied). Hidden
                     when the Unplaced pane is right-clicked. -->
                <MenuItem Header="Add Missing Card..."
                          Command="{Binding AddMissingCardCommand}"
                          Visibility="{Binding HasSlotContext, Converter={conv:BoolToVisibilityConverter}}"/>
                <Separator Visibility="{Binding HasSlotContext, Converter={conv:BoolToVisibilityConverter}}"/>
                <MenuItem Header="Open Card Editor"
                          Command="{Binding OpenCardEditorCommand}"/>
                <MenuItem Header="Copy Card Name(s)"
                          Command="{Binding CopyCardNamesCommand}"/>
                <Separator/>
                <MenuItem Header="Move to Location..."
                          Command="{Binding MoveToLocationCommand}"/>
                <MenuItem Header="Remove from Binder Page"
                          Command="{Binding UnassignFromPageCommand}"
                          Visibility="{Binding SelectionIsPlaced, Converter={conv:BoolToVisibilityConverter}}"/>
                <MenuItem Header="Tags..."
                          IsEnabled="{Binding HasSelection}"
                          Click="TagsMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="List for Sale..."
                          Command="{Binding ListForSaleCommand}"/>
                <MenuItem Header="Mark Picked"
                          Command="{Binding MarkPickedCommand}"/>
                <MenuItem Header="Unlist"
                          Command="{Binding UnlistForSaleCommand}"/>
                <Separator/>
                <MenuItem Header="Set Condition">
                    <MenuItem Header="NM" Command="{Binding SetConditionCommand}" CommandParameter="NM"/>
                    <MenuItem Header="LP" Command="{Binding SetConditionCommand}" CommandParameter="LP"/>
                    <MenuItem Header="MP" Command="{Binding SetConditionCommand}" CommandParameter="MP"/>
                    <MenuItem Header="HP" Command="{Binding SetConditionCommand}" CommandParameter="HP"/>
                    <MenuItem Header="D"  Command="{Binding SetConditionCommand}" CommandParameter="D"/>
                </MenuItem>
                <MenuItem Header="Set Foil"
                          Command="{Binding SetFoilCommand}"
                          CommandParameter="True"/>
                <MenuItem Header="Set Non-Foil"
                          Command="{Binding SetFoilCommand}"
                          CommandParameter="False"/>
                <Separator/>
                <MenuItem Header="List on eBay"
                          Command="{Binding ListOnEbayCommand}"/>
                <MenuItem Header="View on eBay"
                          Command="{Binding ViewOnEbayCommand}"/>
                <MenuItem Header="End eBay Listing"
                          Command="{Binding EndEbayListingCommand}"/>
                <Separator/>
                <MenuItem Header="Delete Selected"
                          Command="{Binding DeleteSelectedCommand}"/>
            </ContextMenu>

            <!-- One binder page: a fixed-size grid of slots. Shared by the left/right page
                 ItemsControls so both sides of the spread render identically. Slot tiles are a
                 constant pixel size (172x240) regardless of window size or Columns/SlotsPerPage —
                 the page's overall footprint is just however many rows that produces, not
                 artificially stretched or shrunk to fill available space. -->
            <DataTemplate x:Key="BinderSlotTemplate">
                <!-- Tag = this slot's BinderSlotItem (Page/SlotIndex/Card), used by Slot_Drop to
                     resolve the drop target's exact page+slot coordinates, and by the page
                     ItemsControl's right-click handler (SlotGrid_PreviewMouseRightButtonDown) to
                     set up the context menu's selection. -->
                <Border Width="172" Height="240" Margin="4"
                        CornerRadius="8"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                        Background="Transparent"
                        AllowDrop="True"
                        Tag="{Binding}"
                        DragOver="Slot_DragOver"
                        Drop="Slot_Drop">
                    <Grid>
                        <!-- Empty-slot placeholder -->
                        <Border CornerRadius="6" BorderThickness="0"
                                Visibility="{Binding Card, Converter={conv:NullToVisibleConverter}}">
                            <TextBlock Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontStyle="Italic" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                        </Border>

                        <!-- Occupied slot: draggable card tile. Tag also carries the BinderSlotItem
                             so SlotCard_MouseDown can build the drag payload without walking the
                             visual tree. -->
                        <ContentControl Content="{Binding Card}"
                                         ContentTemplate="{StaticResource CardTileTemplate}"
                                         Tag="{Binding}"
                                         Visibility="{Binding Card, Converter={conv:NullToCollapsedConverter}}"
                                         PreviewMouseLeftButtonDown="SlotCard_MouseDown"
                                         PreviewMouseMove="SlotCard_MouseMove"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="BinderPagePanel">
                <UniformGrid Columns="{Binding Columns}"/>
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <!-- Wide enough for a real multi-column tile grid (~172px/tile) rather than a single
                 column; resizable via the GridSplitter if the user wants more/fewer columns. -->
            <ColumnDefinition Width="380" MinWidth="180"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left pane: unplaced cards, draggable into the binder grid -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Unplaced Cards" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

            <!-- Filters the Unplaced pool using the same Scryfall query syntax as the main
                 collection search (server-side re-query), e.g. c:u, r>=rare, t:creature.
                 Applies on Enter, like the main search box. -->
            <TextBox x:Name="UnplacedQuickFilterBox"
                     DockPanel.Dock="Top"
                     Margin="0,0,0,6"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                     materialDesign:HintAssist.Hint="Filter (Scryfall syntax) — e.g. c:u, r>=rare"
                     Text="{Binding UnplacedFilterQuery, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ApplyUnplacedFilterCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <ListBox x:Name="UnplacedListBox"
                     ItemsSource="{Binding UnplacedCards}"
                     ItemTemplate="{StaticResource CardTileTemplate}"
                     SelectionMode="Extended"
                     HorizontalContentAlignment="Stretch"
                     ContextMenu="{StaticResource BinderCardContextMenu}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLengthUnit="Item"
                     VirtualizingPanel.CacheLength="30,30"
                     PreviewMouseRightButtonDown="UnplacedListBox_PreviewMouseRightButtonDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Tag" Value="{Binding}"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="UnplacedCard_MouseDown"/>
                        <EventSetter Event="PreviewMouseMove" Handler="UnplacedCard_MouseMove"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>

        <!-- Right pane: current two-page spread -->
        <DockPanel Grid.Column="2" Margin="12,0,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding ContainerName, StringFormat='Binder — {0}'}" FontWeight="Bold" FontSize="15"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="{Binding PageRangeLabel}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                <TextBlock VerticalAlignment="Center" Margin="4,0,0,0"
                           Text="{Binding TotalPages, StringFormat='of {0}'}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                <!-- Primary action adds the default double-sided sheet (front + back = 2 pages);
                     the caret opens the less-common single-sided option. -->
                <Button Margin="16,0,0,0" Padding="8,4"
                        Command="{Binding AddPageCommand}" CommandParameter="double"
                        ToolTip="Add a new page (front + back) to the end of this binder">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlusBox" VerticalAlignment="Center"/>
                        <TextBlock Text="Add New Page" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Padding="2" Margin="2,0,0,0" VerticalAlignment="Stretch"
                        Click="AddPageOptionsButton_Click"
                        ToolTip="More page options">
                    <materialDesign:PackIcon Kind="MenuDown" VerticalAlignment="Center"/>
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Add page (front + back)"
                                      Command="{Binding AddPageCommand}" CommandParameter="double"/>
                            <MenuItem Header="Add single-sided page"
                                      Command="{Binding AddPageCommand}" CommandParameter="single"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Margin="8,0,0,0" Padding="8,4"
                        Command="{Binding InsertPageCommand}"
                        ToolTip="Insert a new page between existing pages (later pages shift down the binder)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlusBoxMultipleOutline" VerticalAlignment="Center"/>
                        <TextBlock Text="Insert Page…" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Layout controls: slots per page + columns (rows auto-calculate from the two). -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Slots per page:" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <TextBox Text="{Binding PendingSlotsPerPage, UpdateSourceTrigger=PropertyChanged}"
                         Width="50" VerticalAlignment="Center"
                         Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <TextBlock Text="Columns:" VerticalAlignment="Center" Margin="16,0,4,0"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <TextBox Text="{Binding PendingColumns, UpdateSourceTrigger=PropertyChanged}"
                         Width="50" VerticalAlignment="Center"
                         Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <Button Content="Apply Layout" Margin="16,0,0,0" Padding="8,4"
                        Command="{Binding ApplyLayoutCommand}"
                        ToolTip="Changes how many slots this binder page has and how many columns wide the grid is; rows fill in automatically."/>
            </StackPanel>

            <!-- Pagination strip beneath the binder: First / Previous / clickable spread list /
                 Next / Last, mirroring how a real binder is flipped through. -->
            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="4"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding FirstSpreadCommand}"
                            ToolTip="First page">
                        <materialDesign:PackIcon Kind="PageFirst" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding PreviousSpreadCommand}"
                            ToolTip="Previous">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="24" Height="24"/>
                    </Button>

                    <!-- Clickable list of spreads (page 1, then 2–3, 4–5, …). The current spread is
                         highlighted via BinderSpreadTab.IsCurrent. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  MaxWidth="520" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding SpreadTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Margin="2,0" Padding="10,2" MinWidth="34"
                                            Command="{Binding DataContext.GoToSpreadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Index}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding NextSpreadCommand}"
                            ToolTip="Next">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding LastSpreadCommand}"
                            ToolTip="Last page">
                        <materialDesign:PackIcon Kind="PageLast" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <!-- The spread itself: left page, spine, right page — like turning a physical
                     binder open. Both page slots are wrapped in a fixed-size Border (PageWidth x
                     PageHeight) so the open-book shape stays constant across every spread — page 1
                     alone (spread 0, no left page) and a trailing lone page still reserve the same
                     footprint as a real left/right pair would, rather than the layout visibly
                     shrinking to one page's width. Left-aligned/top-aligned so the spread sits at
                     its natural fixed size instead of stretching to fill the pane. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <!-- Left page: a fixed-height header (page number + per-page Remove) above the
                         fixed-footprint slot grid. The header keeps its height even when there's no
                         left page (spread 0) so the two pages' grids stay vertically aligned. -->
                    <StackPanel Orientation="Vertical">
                        <Grid Width="{Binding PageWidth}" Height="30" Margin="4,0,4,2">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold"
                                       Text="{Binding LeftPageNumber, StringFormat='Page {0}'}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                       Visibility="{Binding HasLeftPage, Converter={conv:BoolToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding HasLeftPage, Converter={conv:BoolToVisibilityConverter}}">
                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0"
                                        Command="{Binding MovePageCommand}" CommandParameter="{Binding LeftPageNumber}"
                                        ToolTip="Move this page (and its other side) to another spot in the binder">
                                    <materialDesign:PackIcon Kind="CursorMove" Width="18" Height="18"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0"
                                        Command="{Binding RemovePageCommand}" CommandParameter="{Binding LeftPageNumber}"
                                        ToolTip="Remove this page and its other side; cards return to Unplaced">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                            <ItemsControl ItemsSource="{Binding LeftPageSlots}"
                                          ItemTemplate="{StaticResource BinderSlotTemplate}"
                                          ItemsPanel="{StaticResource BinderPagePanel}"
                                          ContextMenu="{StaticResource BinderCardContextMenu}"
                                          ContextMenuOpening="SlotGrid_ContextMenuOpening"
                                          Visibility="{Binding HasLeftPage, Converter={conv:BoolToVisibilityConverter}}"/>
                        </Border>
                    </StackPanel>

                    <!-- Binder spine -->
                    <Border Width="6" Margin="6,4"
                            Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                            CornerRadius="3"/>

                    <StackPanel Orientation="Vertical">
                        <Grid Width="{Binding PageWidth}" Height="30" Margin="4,0,4,2">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold"
                                       Text="{Binding RightPageNumber, StringFormat='Page {0}'}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                       Visibility="{Binding HasRightPage, Converter={conv:BoolToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding HasRightPage, Converter={conv:BoolToVisibilityConverter}}">
                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0"
                                        Command="{Binding MovePageCommand}" CommandParameter="{Binding RightPageNumber}"
                                        ToolTip="Move this page (and its other side) to another spot in the binder">
                                    <materialDesign:PackIcon Kind="CursorMove" Width="18" Height="18"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0"
                                        Command="{Binding RemovePageCommand}" CommandParameter="{Binding RightPageNumber}"
                                        ToolTip="Remove this page and its other side; cards return to Unplaced">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                            <ItemsControl ItemsSource="{Binding RightPageSlots}"
                                          ItemTemplate="{StaticResource BinderSlotTemplate}"
                                          ItemsPanel="{StaticResource BinderPagePanel}"
                                          ContextMenu="{StaticResource BinderCardContextMenu}"
                                          ContextMenuOpening="SlotGrid_ContextMenuOpening"
                                          Visibility="{Binding HasRightPage, Converter={conv:BoolToVisibilityConverter}}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Popup x:Name="TagsPopup" StaysOpen="False" Placement="MousePoint">
            <helpers:TagFlyout Tags="{Binding TagFlyoutItems}"
                                ToggleCommand="{Binding ToggleTagFlyoutItemCommand}"
                                NewTagCommand="{Binding CreateTagFlyoutItemCommand}"/>
        </Popup>
    </Grid>
</Window>
