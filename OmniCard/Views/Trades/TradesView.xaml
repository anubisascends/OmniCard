<Window x:Class="OmniCard.Views.Trades.TradesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Trades" Height="620" Width="900"
        MinHeight="440" MinWidth="700"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Trade history" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"
                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Session list -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding ViewModel.Trades}"
                     SelectedItem="{Binding ViewModel.SelectedTrade}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="66" CornerRadius="4"
                                    Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                                    Margin="0,0,8,0">
                                <Image Source="{Binding ThumbnailPath, Converter={conv:LocalFilePathToImageConverter}}"
                                       Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}">
                                    <Run Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy}', Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding ReplacementCount, Mode=OneWay, StringFormat='{}{0} received'}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Column="0" Text="No trades recorded yet."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                       Visibility="{Binding ViewModel.Trades.Count, Converter={conv:ZeroToVisibleConverter}}"/>

            <!-- Detail -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding ViewModel.SelectedTrade}">
                <StackPanel>
                    <TextBlock Text="Cards given" FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <ItemsControl ItemsSource="{Binding OutgoingCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="56" CornerRadius="3" Margin="0,0,8,0"
                                            Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}">
                                        <Image Source="{Binding PhotoPath, Converter={conv:LocalFilePathToImageConverter}}"
                                               Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                            <Run Text="{Binding CardName, Mode=OneWay}"/>
                                            <Run Text="{Binding Foil, Converter={conv:FoilSuffixConverter}, Mode=OneWay}"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}">
                                            <Run Text="{Binding SetName, Mode=OneWay}"/><Run Text="{Binding SetCode, Mode=OneWay, StringFormat=' ({0})'}"/>
                                        </TextBlock>
                                        <TextBlock Text="Off-database (card-show pickup)" FontSize="10" FontStyle="Italic"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                                                   Visibility="{Binding IsOffDatabase, Converter={conv:BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{Binding EstimatedValue, StringFormat='{}{0:C}', Mode=OneWay}"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Given" FontSize="11"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                            <TextBlock Text="{Binding OutgoingValue, StringFormat='{}{0:C}', Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Received" FontSize="11"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                            <TextBlock Text="{Binding ReceivedValue, StringFormat='{}{0:C}', Mode=OneWay, TargetNullValue='—'}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Delta" FontSize="11"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                            <TextBlock Text="{Binding ValueDelta, StringFormat='{}{0:C}', Mode=OneWay, TargetNullValue='—'}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Note" FontWeight="Bold" Margin="0,10,0,2"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                    <TextBlock Text="Cards received (photo)" FontWeight="Bold" Margin="0,10,0,4"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <Border MaxHeight="260" HorizontalAlignment="Left" CornerRadius="4"
                            Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}">
                        <Image Source="{Binding ReceivedPhotoPath, Converter={conv:LocalFilePathToImageConverter}}"
                               Stretch="Uniform" MaxHeight="256"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" Command="{Binding ViewModel.CloseCommand}"
                    IsCancel="True" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
