<Window x:Class="OmniCard.Views.DeckBoxSync.DeckBoxSyncView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OmniCard.Views.DeckBoxSync"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Upgrade Deck" Height="640" Width="1000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance {x:Type local:DeckBoxSyncView}}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input: URL fetch + paste-text -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Deck source — paste a Moxfield/Archidekt URL, or a decklist as text:"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,2"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ViewModel.UrlText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         materialDesign:HintAssist.Hint="https://moxfield.com/decks/…"
                         Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <Button Grid.Column="1" Content="Load URL" VerticalAlignment="Center" Padding="12,4"
                        Command="{Binding ViewModel.FetchCommand}"
                        IsEnabled="{Binding ViewModel.NotBusy}"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ViewModel.PasteText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinLines="2" MaxLines="4" VerticalScrollBarVisibility="Auto"
                         materialDesign:HintAssist.Hint="1 Sol Ring (C21) 263"
                         Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Load text" VerticalAlignment="Top" Padding="12,4"
                        Command="{Binding ViewModel.ParsePastedCommand}"
                        IsEnabled="{Binding ViewModel.NotBusy}"/>
            </Grid>
            <TextBlock Text="{Binding ViewModel.StatusMessage}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,6,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding ViewModel.HeaderLabel}" FontWeight="SemiBold" FontSize="14"
                   Margin="0,0,0,8" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

        <!-- Two review lists: Cut (left) and Add (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CUT -->
            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" Text="Cut from deck" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ViewModel.Cuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6" Margin="4" BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Text="{Binding SetCode}" FontSize="11" Opacity="0.7"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <!-- No GroupName: WPF scopes radios per item container. -->
                                                <RadioButton Content="Sideboard" IsChecked="{Binding Sideboard}"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"
                                                             ToolTip="Keep in the deck box and tag as sideboard"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                <RadioButton Content="Move to" IsChecked="{Binding MoveToEditable}"
                                                             Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                <ComboBox Width="200" DisplayMemberPath="Name"
                                                          ItemsSource="{Binding AvailableLocations}"
                                                          SelectedItem="{Binding SelectedLocation}"
                                                          IsEnabled="{Binding MoveToEditable}"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- ADD -->
            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Add to deck" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ViewModel.Adds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6" Margin="4" BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Text="{Binding NoSourceHint}" FontSize="11" Opacity="0.7"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                       Visibility="{Binding NoSources, Converter={StaticResource BoolToVis}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                        Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                <ComboBox Width="240" DisplayMemberPath="Display"
                                                          ItemsSource="{Binding Sources}"
                                                          SelectedItem="{Binding SelectedSource}"
                                                          IsEnabled="{Binding NotSkip}"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                <CheckBox Content="Skip" IsChecked="{Binding Skip}" Margin="8,0,0,0"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Leave this card missing from the deck"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Apply" Command="{Binding ViewModel.CommitCommand}"
                    IsEnabled="{Binding ViewModel.CanCommit}" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Cancel" Command="{Binding ViewModel.CancelCommand}" Padding="16,4" IsCancel="True"
                    IsEnabled="{Binding ViewModel.NotBusy}"/>
        </StackPanel>
    </Grid>
</Window>
