<Window x:Class="OmniCard.Views.StorageManager.StorageManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OmniCard.Views.StorageManager"
        xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
        xmlns:models="clr-namespace:OmniCard.Models;assembly=OmniCard.Shared"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance {x:Type local:StorageManagerView}}"
        Title="Manage Storage Locations" Height="600" Width="660"
        MinHeight="400" MinWidth="580"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Collapsible location groups -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LocationGroupViewModel}">
                        <Border Margin="0,0,0,4" CornerRadius="4"
                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                          <StackPanel>
                            <!-- Group header: click to collapse/expand (instant, no animation) -->
                            <Border Background="Transparent" Padding="8,6" Cursor="Hand"
                                    MouseLeftButtonUp="GroupHeader_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                                                             RenderTransformOrigin="0.5,0.5">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{Binding TypeDisplay}" FontWeight="SemiBold" Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    <TextBlock Text="{Binding Items.Count, StringFormat=' ({0})'}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="8,0,8,8"
                                        Visibility="{Binding IsExpanded, Converter={conv:BoolToVisibilityConverter}}">
                                <!-- Inline add row -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="220" VerticalAlignment="Center"
                                             materialDesign:HintAssist.Hint="New location name…"
                                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Command="{Binding AddCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Add location" Margin="4,0,0,0" Height="32" Width="32">
                                        <materialDesign:PackIcon Kind="Plus"/>
                                    </Button>
                                    <TextBlock Text="{Binding NameError}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="#E53935"
                                               Visibility="{Binding NameError, Converter={conv:StringToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Location rows -->
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ContainerDisplayItem}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Delete button (left) -->
                                                <Button Grid.Column="0" Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="Delete location" Height="28" Width="28" Margin="0,0,6,0"
                                                        Click="DeleteLocation_Click" Tag="{Binding}">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                                                </Button>

                                                <!-- Name: text (double-click to rename) / inline edit box -->
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                               ToolTip="Double-click to rename"
                                                               MouseLeftButtonDown="LocationName_MouseLeftButtonDown"
                                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                               Visibility="{Binding IsEditing, Converter={conv:InverseBoolToVisibilityConverter}}"/>
                                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             KeyDown="RenameBox_KeyDown"
                                                             LostFocus="RenameBox_LostFocus"
                                                             IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                             Visibility="{Binding IsEditing, Converter={conv:BoolToVisibilityConverter}}"/>
                                                </Grid>

                                                <TextBlock Grid.Column="2" Text="{Binding CardCount}" VerticalAlignment="Center"
                                                           ToolTip="Cards in this location"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                <Button Grid.Column="3" Content="QR" ToolTip="Copy barcode text to clipboard"
                                                        Command="{Binding DataContext.ViewModel.CopyQrTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"
                                                        Padding="6,1" FontSize="10" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="4" ToolTip="Exclude from deck check"
                                                          IsChecked="{Binding ExcludeFromDeckCheck, Mode=OneWay}"
                                                          Command="{Binding DataContext.ViewModel.ToggleDeckCheckExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"
                                                          Margin="8,0,0,0" VerticalAlignment="Center"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                          Content="Exclude"/>
                                                <CheckBox Grid.Column="5"
                                                          ToolTip="Always show this location (grouped with Bulk) and never hide it with the game filter"
                                                          IsChecked="{Binding IsAlwaysAvailable, Mode=OneWay}"
                                                          IsEnabled="{Binding IsSystem, Converter={conv:InverseBoolConverter}}"
                                                          Command="{Binding DataContext.ViewModel.ToggleAlwaysAvailableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"
                                                          Margin="8,0,0,0" VerticalAlignment="Center"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                          Content="Always Available"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Web app base URL -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,8">
            <TextBlock Text="Web App URL:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBox Text="{Binding ViewModel.BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                     Width="260" VerticalAlignment="Center" FontSize="11"/>
            <Button Content="Use My IP" Command="{Binding ViewModel.UseMyIpCommand}"
                    Padding="8,2" Margin="4,0,0,0" FontSize="11"
                    ToolTip="Set URL to this computer's IP address"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>

        <!-- Close button -->
        <Button Grid.Row="2" Content="Close" Command="{Binding ViewModel.CloseCommand}"
                HorizontalAlignment="Right" Padding="16,4"/>
    </Grid>
</Window>
