<UserControl x:Class="OmniCard.Views.Sets.SetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OmniCard.Views.Sets"
             xmlns:helpers="clr-namespace:OmniCard.Controls;assembly=OmniCard.Controls"
             xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesign.Brush.Background}"
             TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
             d:DesignHeight="700" d:DesignWidth="1100"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Root/CardTileTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One checklist tile: the shared card tile + a check/quantity overlay, dimmed when unowned. -->
            <DataTemplate x:Key="ChecklistTileTemplate">
                <Grid Width="172">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Owned}" Value="False">
                                    <Setter Property="Opacity" Value="0.42"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ContentControl Content="{Binding Card}"
                                    ContentTemplate="{StaticResource CardTileTemplate}"/>

                    <!-- Owned check badge (top-right, over the art) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,14,14,0"
                            Background="#E6117A2E" CornerRadius="10" Padding="2"
                            Visibility="{Binding Owned, Converter={conv:BoolToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="CheckBold" Width="16" Height="16" Foreground="White"/>
                    </Border>

                    <!-- Duplicate-copies badge (top-left) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="14,14,0,0"
                            Background="#E61565C0" CornerRadius="9" Padding="5,1"
                            Visibility="{Binding ShowQuantityBadge, Converter={conv:BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding QuantityText}" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: game + set picker, load, completion, print -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Width="150" Margin="0,0,8,0"
                      materialDesign:HintAssist.Hint="Game"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      ItemsSource="{Binding Games}"
                      SelectedItem="{Binding SelectedGame}"/>

            <TextBox Grid.Column="1" Width="170" Margin="0,0,8,0"
                     materialDesign:HintAssist.Hint="Filter sets"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding SetFilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>

            <ComboBox Grid.Column="2" Width="280" Margin="0,0,8,0"
                      materialDesign:HintAssist.Hint="Set"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      ItemsSource="{Binding Sets}"
                      SelectedItem="{Binding SelectedSet}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding SetName, Mode=OneWay}"/>
                            <Run Text="{Binding SetCode, Mode=OneWay, StringFormat=' ({0})'}"
                                 Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center"
                    Content="Load"
                    Command="{Binding LoadSetCommand}"/>

            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       Text="{Binding CompletionText}"/>

            <Button Grid.Column="6" VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Print Want List…"
                    Command="{Binding ExportWantListCommand}"/>
        </Grid>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="1" Height="4" Margin="0,8,0,0"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={conv:BoolToVisibilityConverter}}"/>

        <!-- Card grid (read-only) -->
        <ListBox Grid.Row="2" Margin="0,8,0,0"
                 ItemsSource="{Binding ChecklistCards}"
                 ItemTemplate="{StaticResource ChecklistTileTemplate}"
                 HorizontalContentAlignment="Stretch"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.CacheLengthUnit="Item"
                 VirtualizingPanel.CacheLength="30,30"
                 IsTextSearchEnabled="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!-- Read-only: strip selection/hover chrome so tiles read as a checklist, not a picker. -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock Grid.Row="3" Margin="0,6,0,0"
                   FontStyle="Italic"
                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding StatusMessage, Converter={conv:StringToVisibilityConverter}}"/>
    </Grid>
</UserControl>
