<Window x:Class="OmniCard.Views.BinderAudit.BinderAuditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmniCard.Views.BinderAudit"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Title="{Binding ContainerName, StringFormat='Audit Binder — {0}'}"
        Height="900" Width="1400"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Root/CardTileTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One read-only binder pocket with an audit button bar. Filled pockets get
                 Correct / Missing / Wrong; empty pockets get Extra. The current mark is shown as a
                 colored border. Buttons reach the VM commands via the page ItemsControl's DataContext,
                 passing this pocket's BinderAuditSlotItem as the parameter. -->
            <DataTemplate x:Key="BinderAuditSlotTemplate">
                <Border Width="172" Height="240" Margin="4"
                        CornerRadius="8"
                        BorderThickness="2"
                        Background="Transparent">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mark}" Value="Correct">
                                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mark}" Value="Missing">
                                    <Setter Property="BorderBrush" Value="#F44336"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mark}" Value="Wrong">
                                    <Setter Property="BorderBrush" Value="#FF9800"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mark}" Value="ExtraPresent">
                                    <Setter Property="BorderBrush" Value="#2196F3"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Empty pocket: plain hint, or the reverse-side card-back hint (matches BinderView). -->
                        <Border CornerRadius="6" BorderThickness="0"
                                Visibility="{Binding Card, Converter={conv:NullToVisibleConverter}}">
                            <Grid>
                                <TextBlock Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontStyle="Italic" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                                           Visibility="{Binding HasCardOnReverse, Converter={conv:InverseBoolToVisibilityConverter}}"/>
                                <Border CornerRadius="6" Margin="10"
                                        ToolTip="{Binding ReverseCardName}"
                                        Visibility="{Binding HasCardOnReverse, Converter={conv:BoolToVisibilityConverter}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2A3B55" Offset="0"/>
                                            <GradientStop Color="#16233A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Border CornerRadius="4" Margin="8" BorderThickness="1" BorderBrush="#3E5680"/>
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding ReverseGame, Converter={conv:CardBackImageConverter}}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Occupied pocket: the read-only card tile. -->
                        <ContentControl Content="{Binding Card}"
                                        ContentTemplate="{StaticResource CardTileTemplate}"
                                        Visibility="{Binding Card, Converter={conv:NullToCollapsedConverter}}"/>

                        <!-- Audit button bar, anchored bottom-center. -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6"
                                CornerRadius="14" Padding="2"
                                Background="#CC000000">
                            <StackPanel Orientation="Horizontal">
                                <!-- Filled-pocket actions -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsOccupied, Converter={conv:BoolToVisibilityConverter}}">
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0"
                                            ToolTip="Correct — card is present and right"
                                            Command="{Binding DataContext.MarkCorrectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="#4CAF50"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0"
                                            ToolTip="Missing — card is not physically here"
                                            Command="{Binding DataContext.MarkMissingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Minus" Width="18" Height="18" Foreground="#F44336"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0"
                                            ToolTip="Wrong — wrong card or printing"
                                            Command="{Binding DataContext.MarkWrongCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="18" Height="18" Foreground="#FF9800"/>
                                    </Button>
                                </StackPanel>
                                <!-- Empty-pocket action -->
                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0"
                                        ToolTip="Extra — a card is here that the app doesn't know about"
                                        Visibility="{Binding IsOccupied, Converter={conv:InverseBoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.MarkExtraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#2196F3"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="BinderAuditPagePanel">
                <UniformGrid Columns="{Binding Columns}"/>
            </ItemsPanelTemplate>

            <!-- One flagged pocket in the review step. Missing rows are informational; Wrong/Extra
                 rows expose a catalog search + results list to choose the correct card. -->
            <DataTemplate x:Key="ReviewRowTemplate">
                <Border Margin="0,0,0,10" Padding="12" CornerRadius="6"
                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mark}" Value="Missing">
                                                <Setter Property="Background" Value="#F44336"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mark}" Value="Wrong">
                                                <Setter Property="Background" Value="#FF9800"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Mark}" Value="ExtraPresent">
                                                <Setter Property="Background" Value="#2196F3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding MarkLabel}" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding PocketLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentLabel}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                        </StackPanel>

                        <!-- Missing: informational only. -->
                        <TextBlock Margin="0,6,0,0"
                                   Text="Will be flagged as missing (kept in your collection)."
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                                   Visibility="{Binding RequiresSelection, Converter={conv:InverseBoolToVisibilityConverter}}"/>

                        <!-- Wrong/Extra: search + pick the correct card. -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding RequiresSelection, Converter={conv:BoolToVisibilityConverter}}">
                            <TextBox materialDesign:HintAssist.Hint="Search the catalog by name, then press Enter"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return"
                                                Command="{Binding DataContext.SearchRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <ListBox Margin="0,6,0,0" MaxHeight="180"
                                     ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedMatch, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Margin="8,0,0,0"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}">
                                                <Run Text="{Binding SetCode}"/>
                                                <Run Text="#"/><Run Text="{Binding CollectorNumber}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                       Visibility="{Binding SelectedMatch, Converter={conv:NullToCollapsedConverter}}">
                                <Run Text="Selected: "/><Run Text="{Binding SelectedMatch.Name}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <!-- ============================ Marking view ============================ -->
        <DockPanel Visibility="{Binding IsReviewMode, Converter={conv:InverseBoolToVisibilityConverter}}">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding ContainerName, StringFormat='Audit Binder — {0}'}" FontWeight="Bold" FontSize="15"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="{Binding PageRangeLabel}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                <TextBlock VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="{Binding AuditProgress}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
            </StackPanel>

            <!-- How-to legend -->
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                       Text="For each pocket: ✓ correct · − missing · ? wrong card/printing. For an empty pocket that physically holds a card: + extra. Tap again to clear. When done, click Review &amp; Apply."/>

            <!-- Footer: review action + pagination -->
            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="4"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    CornerRadius="6">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding FirstSpreadCommand}" ToolTip="First page">
                            <materialDesign:PackIcon Kind="PageFirst" Width="24" Height="24"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding PreviousSpreadCommand}" ToolTip="Previous">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="24" Height="24"/>
                        </Button>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      MaxWidth="520" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding SpreadTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                Margin="2,0" Padding="10,2" MinWidth="34"
                                                Command="{Binding DataContext.GoToSpreadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Index}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding NextSpreadCommand}" ToolTip="Next">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding LastSpreadCommand}" ToolTip="Last page">
                            <materialDesign:PackIcon Kind="PageLast" Width="24" Height="24"/>
                        </Button>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Padding="12,4" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding BeginReviewCommand}"
                            ToolTip="Review the flagged pockets and apply corrections">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline" VerticalAlignment="Center"/>
                            <TextBlock Text="Review &amp; Apply" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- The spread -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical">
                        <Grid Width="{Binding PageWidth}" Height="30" Margin="4,0,4,2">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold"
                                       Text="{Binding LeftPageNumber, StringFormat='Page {0}'}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                       Visibility="{Binding HasLeftPage, Converter={conv:BoolToVisibilityConverter}}"/>
                        </Grid>
                        <Border Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                            <ItemsControl ItemsSource="{Binding LeftPageSlots}"
                                          ItemTemplate="{StaticResource BinderAuditSlotTemplate}"
                                          ItemsPanel="{StaticResource BinderAuditPagePanel}"
                                          Visibility="{Binding HasLeftPage, Converter={conv:BoolToVisibilityConverter}}"/>
                        </Border>
                    </StackPanel>

                    <Border Width="6" Margin="6,4"
                            Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                            CornerRadius="3"/>

                    <StackPanel Orientation="Vertical">
                        <Grid Width="{Binding PageWidth}" Height="30" Margin="4,0,4,2">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold"
                                       Text="{Binding RightPageNumber, StringFormat='Page {0}'}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                       Visibility="{Binding HasRightPage, Converter={conv:BoolToVisibilityConverter}}"/>
                        </Grid>
                        <Border Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                            <ItemsControl ItemsSource="{Binding RightPageSlots}"
                                          ItemTemplate="{StaticResource BinderAuditSlotTemplate}"
                                          ItemsPanel="{StaticResource BinderAuditPagePanel}"
                                          Visibility="{Binding HasRightPage, Converter={conv:BoolToVisibilityConverter}}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ============================ Review & apply view ============================ -->
        <DockPanel Visibility="{Binding IsReviewMode, Converter={conv:BoolToVisibilityConverter}}">
            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"
                       Text="{Binding ContainerName, StringFormat='Review Corrections — {0}'}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                       Text="Confirm each flagged pocket. Wrong and Extra pockets need a card selected before you can apply."/>

            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Padding="14,6" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ExitReviewCommand}"
                            Content="Back to Marking"/>
                    <Button Padding="14,6"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ApplyCorrectionsCommand}"
                            Content="Apply Corrections"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ReviewRows}"
                              ItemTemplate="{StaticResource ReviewRowTemplate}"
                              MaxWidth="820" HorizontalAlignment="Left"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
