<UserControl x:Class="OmniCard.Views.Settings.ScannerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OmniCard.Views.Settings"
             xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
             xmlns:models="clr-namespace:OmniCard.Models;assembly=OmniCard.Shared"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type local:ScannerSettingsViewModel}}">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="WorkflowModes"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ScanWorkflowMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16"
                MaxWidth="560"
                HorizontalAlignment="Left">

            <TextBlock Text="Scan Workflow"
                    FontWeight="SemiBold"
                    FontSize="16"
                    Margin="0,0,0,12"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBlock TextWrapping="Wrap"
                    Margin="0,0,0,12"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                <Run Text="Store keeps every scanned card's image in the scans folder after commit. Discard deletes each scan's image once its card has been committed to the database — nothing permanent is kept."/>
            </TextBlock>

            <ComboBox Width="240"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16"
                      ItemsSource="{Binding Source={StaticResource WorkflowModes}}"
                      SelectedItem="{Binding WorkflowMode}"
                      Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

            <TextBlock Text="Scan Archives"
                    FontWeight="SemiBold"
                    FontSize="16"
                    Margin="0,8,0,12"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBlock TextWrapping="Wrap"
                    Margin="0,0,0,12"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                <Run Text="Import a previously archived scans .zip to restore its images and relink them to their inventory records."/>
            </TextBlock>

            <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,16">
                <Button Content="Import Scan Archive..."
                        Command="{Binding ImportArchiveCommand}"
                        Padding="12,4"
                        Margin="0,0,12,0"
                        IsEnabled="{Binding IsBusy, Converter={conv:InverseBoolConverter}}"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
