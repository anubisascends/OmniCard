<UserControl x:Class="OmniCard.Views.Settings.ScannerCapabilitiesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OmniCard.Views.Settings"
             xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type local:ScannerCapabilitiesSettingsViewModel}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <CollectionViewSource x:Key="GroupedCaps" Source="{Binding Capabilities}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Scanner Capabilities"
                       FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                       Text="Pick a scanner and test its capabilities. Whatever the scanner reports as settable can be adjusted here and is saved per scanner, then applied on top of OmniCard's defaults every scan. Settings OmniCard needs for reliable matching are shown locked."/>

            <!-- Scanner picker + probe -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Width="320" VerticalAlignment="Center" Margin="0,0,8,0"
                          ItemsSource="{Binding AvailableScanners}"
                          SelectedItem="{Binding SelectedScanner}"
                          DisplayMemberPath="Name"
                          Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <Button Content="Test Capabilities"
                        Command="{Binding TestCapabilitiesCommand}"
                        Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="↻"
                        ToolTip="Refresh scanner list"
                        Command="{Binding RefreshScannerListCommand}"
                        Padding="8,4"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

            <!-- Everything below appears once a scanner has been probed -->
            <StackPanel Visibility="{Binding HasProbed, Converter={StaticResource BoolToVis}}">

                <!-- Vendor-specific caps are undocumented; hidden unless the user opts in -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox Content="Show vendor-specific (advanced) capabilities"
                              IsChecked="{Binding ShowVendorCaps}"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                               Text="{Binding HiddenVendorCount, StringFormat='({0} hidden — undocumented, manufacturer-specific)'}"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                </StackPanel>

                <!-- OmniCard tuning (DPI + foil), stored in this scanner's profile -->
                <TextBlock Text="OmniCard Tuning" FontWeight="SemiBold" Margin="0,4,0,6"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="Fast DPI:" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBox Text="{Binding FastDpi, UpdateSourceTrigger=LostFocus}" Width="60"
                                 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="High-Quality DPI:" VerticalAlignment="Center" Margin="0,0,4,0"
                                   ToolTip="0 = the scanner's native default"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBox Text="{Binding HighQualityDpi, UpdateSourceTrigger=LostFocus}" Width="60"
                                 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="Foil Brightness:" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBox Text="{Binding FoilBrightness, UpdateSourceTrigger=LostFocus}" Width="70"
                                 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="Foil Contrast:" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBox Text="{Binding FoilContrast, UpdateSourceTrigger=LostFocus}" Width="70"
                                 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Dynamic capability list, grouped by category -->
                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedCaps}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Margin="0,10,0,4"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Label (+ lock note for protected caps) -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                               ToolTip="{Binding CapId}"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    <TextBlock Text=" 🔒" VerticalAlignment="Center"
                                               ToolTip="Managed by OmniCard for reliable matching"
                                               Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                </StackPanel>

                                <!-- Editor, chosen by Kind; disabled when not settable -->
                                <ContentControl Grid.Column="1" IsEnabled="{Binding Settable}" VerticalAlignment="Center">
                                    <Grid>
                                        <CheckBox IsChecked="{Binding BoolValue}"
                                                  Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"/>
                                        <ComboBox ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding SelectedOption}"
                                                  DisplayMemberPath="Display"
                                                  Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}"
                                                  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsRange, Converter={StaticResource BoolToVis}}">
                                            <Slider Width="160" VerticalAlignment="Center"
                                                    Minimum="{Binding RangeMin}" Maximum="{Binding RangeMax}"
                                                    SmallChange="{Binding RangeStep}" LargeChange="{Binding RangeStep}"
                                                    Value="{Binding RangeValue}"/>
                                            <TextBox Width="60" Margin="8,0,0,0"
                                                     Text="{Binding RangeValue, UpdateSourceTrigger=LostFocus}"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                    </Grid>
                                </ContentControl>

                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Opacity="0.7" TextTrimming="CharacterEllipsis"
                                           Text="{Binding CurrentDisplay, StringFormat='now: {0}'}"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            </Grid>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                       FontSize="11" Opacity="0.65" Margin="2,3,0,0"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            <TextBlock Text="{Binding RangeHint}" TextWrapping="Wrap"
                                       FontSize="11" FontStyle="Italic" Opacity="0.55" Margin="2,2,0,0"
                                       Visibility="{Binding HasRangeHint, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,4" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignFlatSecondaryButton}"/>
                    <Button Content="Reset to Defaults" Command="{Binding ResetToDefaultsCommand}" Padding="12,4"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
