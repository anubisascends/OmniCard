<UserControl x:Class="OmniCard.Views.Settings.SalesWorkflowSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OmniCard.Views.Settings"
             xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type local:SalesWorkflowSettingsViewModel}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="Sales Workflow" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                       Text="Customize the columns on the Orders board. Drag the ≡ handle to reorder. Each lane follows a behavior that drives order accounting: entering a Shipped lane records the sale and removes inventory; Completed and Cancelled are terminal. Created and Packed are ordinary pre-ship stages."/>

            <!-- Column headers -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Text="Name" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                <TextBlock Grid.Column="3" Text="Colour" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                <TextBlock Grid.Column="4" Text="Behavior" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
            </Grid>

            <ListBox x:Name="LaneList" ItemsSource="{Binding Lanes}"
                     SelectedItem="{Binding SelectedLane}"
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="AllowDrop" Value="True"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                CornerRadius="6" Padding="6,4"
                                PreviewMouseLeftButtonDown="Lane_MouseDown"
                                PreviewMouseMove="Lane_MouseMove"
                                Drop="Lane_Drop" DragOver="Lane_DragOver"
                                Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Drag handle -->
                                <TextBlock Grid.Column="0" Text="≡" FontSize="16" Cursor="SizeNS"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           ToolTip="Drag to reorder"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>

                                <!-- Colour swatch -->
                                <Border Grid.Column="1" Width="16" Height="16" CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={conv:HexColorToBrushConverter}}"/>

                                <TextBox Grid.Column="2" Margin="4,0,8,0" VerticalAlignment="Center"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                                <TextBox Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center"
                                         ToolTip="Hex colour, e.g. #2196F3"
                                         Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                                <ComboBox Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding DataContext.Behaviors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Behavior}"
                                          Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <Button Content="↑" Width="26" Padding="0" Margin="0,0,2,0" ToolTip="Move up"
                                            Command="{Binding DataContext.MoveLaneUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="↓" Width="26" Padding="0" Margin="0,0,2,0" ToolTip="Move down"
                                            Command="{Binding DataContext.MoveLaneDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="✕" Width="26" Padding="0" ToolTip="Remove lane"
                                            Command="{Binding DataContext.RemoveLaneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="+ Add lane" Command="{Binding AddLaneCommand}" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" Padding="12,4" Margin="0,0,8,0"/>
                <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,4" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
