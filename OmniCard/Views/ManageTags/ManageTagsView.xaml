<Window x:Class="OmniCard.Views.ManageTags.ManageTagsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmniCard.Views.ManageTags"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Manage Tags" Height="480" Width="420"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding ViewModel.Tags}"
                 SelectedItem="{Binding ViewModel.SelectedTag}"
                 Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:TagDisplayItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <TextBlock Text="{Binding UsageCount, StringFormat=' ({0})'}"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Rename panel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding ViewModel.IsEditing, Converter={StaticResource BoolToVis}}">
            <TextBox Text="{Binding ViewModel.EditName, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                     Width="220" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding ViewModel.ConfirmEditCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Cancel" Command="{Binding ViewModel.CancelEditCommand}" Padding="12,4"/>
        </StackPanel>

        <!-- Merge panel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding ViewModel.IsMerging, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Merge into:" VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding ViewModel.MergeCandidates}"
                      SelectedItem="{Binding ViewModel.MergeTarget}"
                      DisplayMemberPath="Name"
                      Width="160" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Merge" Command="{Binding ViewModel.ConfirmMergeCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Cancel" Command="{Binding ViewModel.CancelMergeCommand}" Padding="12,4"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Rename" Command="{Binding ViewModel.ShowEditCommand}"
                    IsEnabled="{Binding ViewModel.HasSelection}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Merge…" Command="{Binding ViewModel.ShowMergeCommand}"
                    IsEnabled="{Binding ViewModel.HasSelection}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Delete" Command="{Binding ViewModel.DeleteSelectedCommand}"
                    IsEnabled="{Binding ViewModel.HasSelection}" Padding="12,6" Margin="0,0,16,0"/>
            <Button Content="Close" Command="{Binding ViewModel.CloseCommand}"
                    IsCancel="True" Padding="16,6" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
