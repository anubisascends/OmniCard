<UserControl x:Class="OmniCard.Views.Root.CardListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
             xmlns:helpers="clr-namespace:OmniCard.Controls;assembly=OmniCard.Controls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CardTileTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Card actions menu, shared by the flat ListBox and the deck-box stacks. x:Shared=False
                 so each host gets its own instance (a ContextMenu can't have two logical parents).
                 Both hosts' DataContext is the ViewModel, so PlacementTarget.DataContext resolves the
                 same commands, and the commands act on the current selection (GetSelectedCards). -->
            <ContextMenu x:Key="CardContextMenu" x:Shared="False"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open Card Editor"
                          Command="{Binding CollectionCardDoubleClickCommand}"/>
                <MenuItem Header="Copy Card Name(s)"
                          Command="{Binding CopyCollectionCardNamesCommand}"/>
                <Separator/>
                <MenuItem Header="Move to Location..."
                          Command="{Binding MoveSelectedToLocationCommand}"/>
                <MenuItem Header="Tags..."
                          IsEnabled="{Binding HasSelection}"
                          Click="TagsMenuItem_Click"/>
                <MenuItem Header="Set as Commander"
                          Command="{Binding SetAsCommanderCommand}"
                          Visibility="{Binding IsCurrentLocationDeckBox, Converter={conv:BoolToVisibilityConverter}}"/>
                <MenuItem Header="Remove Commander"
                          Command="{Binding RemoveCommanderCommand}"
                          Visibility="{Binding IsCurrentLocationDeckBox, Converter={conv:BoolToVisibilityConverter}}"/>
                <Separator/>
                <MenuItem Header="List for Sale..."
                          Command="{Binding ListForSaleCommand}"/>
                <MenuItem Header="Mark Picked"
                          Command="{Binding MarkPickedCommand}"/>
                <MenuItem Header="Unlist"
                          Command="{Binding UnlistForSaleCommand}"/>
                <Separator/>
                <MenuItem Header="Set Condition">
                    <MenuItem Header="NM" Command="{Binding BulkSetCollectionConditionCommand}" CommandParameter="NM"/>
                    <MenuItem Header="LP" Command="{Binding BulkSetCollectionConditionCommand}" CommandParameter="LP"/>
                    <MenuItem Header="MP" Command="{Binding BulkSetCollectionConditionCommand}" CommandParameter="MP"/>
                    <MenuItem Header="HP" Command="{Binding BulkSetCollectionConditionCommand}" CommandParameter="HP"/>
                    <MenuItem Header="D"  Command="{Binding BulkSetCollectionConditionCommand}" CommandParameter="D"/>
                </MenuItem>
                <MenuItem Header="Set Foil"
                          Command="{Binding BulkSetCollectionFoilCommand}"
                          CommandParameter="True"/>
                <MenuItem Header="Set Non-Foil"
                          Command="{Binding BulkSetCollectionFoilCommand}"
                          CommandParameter="False"/>
                <Separator/>
                <MenuItem Header="List on eBay"
                          Command="{Binding ListOnEbayCommand}"/>
                <MenuItem Header="View on eBay"
                          Command="{Binding ViewOnEbayCommand}"/>
                <MenuItem Header="End eBay Listing"
                          Command="{Binding EndEbayListingCommand}"/>
                <Separator/>
                <MenuItem Header="Delete Selected"
                          Command="{Binding BulkDeleteCollectionCommand}"/>
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="200"/>
        <ColumnDefinition x:Name="SidebarSplitterColumn" Width="Auto"/>
        <!-- Width + visibility are driven from code-behind (ApplySidebarLayout). -->
        <ColumnDefinition x:Name="SidebarColumn" Width="0" MinWidth="0"/>
    </Grid.ColumnDefinitions>

    <ListBox x:Name="CollectionListBox"
             ItemsSource="{Binding CollectionSearchResults}"
             SelectedItem="{Binding SelectedCollectionCard}"
             ItemTemplate="{StaticResource CardTileTemplate}"
             Visibility="{Binding IsDeckGroupingActive, Converter={conv:InverseBoolToVisibilityConverter}}"
             SelectionMode="Extended"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             VirtualizingPanel.CacheLengthUnit="Item"
             VirtualizingPanel.CacheLength="30,30"
             IsTextSearchEnabled="False"
             SelectionChanged="CollectionListBox_SelectionChanged"
             PreviewMouseRightButtonDown="CollectionListBox_PreviewMouseRightButtonDown"
             PreviewTextInput="CollectionListBox_PreviewTextInput"
             PreviewKeyDown="CollectionListBox_PreviewKeyDown">

        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None"/>
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <!-- Tile container: flat, with a selection highlight border -->
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="SelBorder"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    CornerRadius="8"
                                    Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- IsSelected declared after IsMouseOver so its setters win when both are
                                     active — otherwise hovering a selected tile silently overwrote the
                                     selection-colored border with the (weaker) hover border, making
                                     selected tiles look unselected under the mouse. Also thickened so
                                     selection reads clearly even against the hover background. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SelBorder" Property="BorderBrush"
                                            Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelBorder" Property="BorderBrush"
                                            Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                    <Setter TargetName="SelBorder" Property="BorderThickness" Value="3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>

        <ListBox.ContextMenu>
            <StaticResource ResourceKey="CardContextMenu"/>
        </ListBox.ContextMenu>

        <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseDoubleClick">
                <i:InvokeCommandAction Command="{Binding CollectionCardDoubleClickCommand}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>

    </ListBox>

    <!-- Deck-box grouped "stacks" view: shown for a deck box when a Group-by axis is chosen.
         Each group is a fanned pile of overlapping cards (CardStack) that expands on hover. -->
    <ScrollViewer x:Name="DeckGroupsScroll"
                  Grid.Column="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="8"
                  PreviewMouseWheel="DeckGroupsScroll_PreviewMouseWheel"
                  Visibility="{Binding IsDeckGroupingActive, Converter={conv:BoolToVisibilityConverter}}">
        <ItemsControl ItemsSource="{Binding DeckGroups}"
                      ContextMenu="{StaticResource CardContextMenu}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6,0,6,10" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Header}"
                                   FontWeight="Bold"
                                   Margin="2,0,0,6"
                                   MaxWidth="{Binding DataContext.DeckCardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <helpers:CardStack ItemsSource="{Binding Cards}"
                                           HorizontalAlignment="Left"
                                           CardPressed="DeckStackCard_Pressed"
                                           CardWidth="{Binding DataContext.DeckCardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           DataDirectory="{Binding DataContext.DataDirectory, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

    <!-- Type-ahead find indicator: shown while the user is typing to jump to a card by name.
         Anchored bottom-left over the card list; driven entirely from code-behind. -->
    <Border x:Name="TypeAheadOverlay"
            Grid.Column="0"
            Visibility="Collapsed"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Margin="12"
            Padding="12,8"
            CornerRadius="6"
            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Find: "
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
            <TextBlock x:Name="TypeAheadText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBlock x:Name="TypeAheadHint"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
        </StackPanel>
    </Border>

    <Popup x:Name="TagsPopup" StaysOpen="False" Placement="MousePoint">
        <helpers:TagFlyout Tags="{Binding TagFlyoutItems}"
                            ToggleCommand="{Binding ToggleTagFlyoutItemCommand}"
                            NewTagCommand="{Binding CreateTagFlyoutItemCommand}"/>
    </Popup>

    <!-- Resizable divider between the card list and the details panel (shown only when open) -->
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" Visibility="Collapsed"
                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                  Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                  DragCompleted="SidebarSplitter_DragCompleted"/>

    <!-- Card details panel: always present (collapsible/resizable by the user, independent of
         selection). Shows readonly, copyable fields common to every selected card; empty (just
         the title) with nothing selected. QTY only shows for a single stacked tile. -->
    <Border x:Name="SidebarPanel"
            Grid.Column="2"
            Padding="12"
            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
            BorderThickness="1,0,0,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left"
                           Text="Card Details"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <Button DockPanel.Dock="Right" Content="›" FontSize="15" Padding="8,0" MinWidth="28"
                        Command="{Binding CollapseSidebarCommand}" ToolTip="Collapse panel"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SidebarFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Label}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                                <!-- Readonly TextBox (not TextBlock) so mouse drag-select, Ctrl+C,
                                     and the right-click Copy context menu all work natively. -->
                                <TextBox Text="{Binding Value, Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         TextWrapping="Wrap"
                                         Cursor="IBeam"
                                         Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>

    <!-- Reopen handle, shown at the list's right edge only when the panel is collapsed -->
    <Button x:Name="SidebarExpandHandle" Grid.Column="0" Visibility="Collapsed"
            HorizontalAlignment="Right" VerticalAlignment="Center"
            Width="16" Height="64" Content="‹" FontSize="15" Padding="0"
            Command="{Binding ExpandSidebarCommand}" ToolTip="Show card details"/>
    </Grid>
</UserControl>
