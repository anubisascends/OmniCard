<UserControl x:Class="OmniCard.Views.Inventory.InventoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:OmniCard.Views.Inventory">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Padding="8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Scan UPC:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <TextBox x:Name="ScanBox" Width="180" VerticalAlignment="Center" Margin="0,0,4,0"
                         Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                         ToolTip="Focus here and scan a barcode. Known UPC → add a lot; new UPC → create the product."
                         Text="{Binding ScanUpc, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ScanUpcCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Scan" Command="{Binding ScanUpcCommand}"
                        Padding="8,4" Margin="0,0,8,0"/>
                <Separator/>
                <Button Content="Add Product..." Command="{Binding AddProductCommand}"
                        Padding="12,4" FontWeight="SemiBold" Margin="8,0,8,0"/>
                <Button Content="Edit..." Command="{Binding EditProductCommand}"
                        Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="Add Lot..." Command="{Binding AddLotCommand}"
                        Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="Open Units..." Command="{Binding OpenUnitsCommand}"
                        Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="Delete" Command="{Binding DeleteProductCommand}"
                        Padding="8,4" Margin="0,0,8,0"/>
                <Separator/>
                <Button Content="Refresh" Command="{Binding RefreshInventoryCommand}"
                        Padding="8,4" Margin="8,0,0,0"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
                <Button Content="Refresh Sealed Prices" Command="{Binding RefreshSealedPricesCommand}"
                        Padding="8,4" Margin="8,0,0,0"
                        ToolTip="Query eBay for current sealed-product median prices"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </Border>

        <!-- Header totals -->
        <Border Grid.Row="1" Padding="8,4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,20,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                    <Run Text="Units:" FontWeight="SemiBold"/>
                    <Run Text="{Binding TotalUnits, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="0,0,20,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                    <Run Text="Cost:" FontWeight="SemiBold"/>
                    <Run Text="{Binding TotalCost, StringFormat='${0:N2}', Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                    <Run Text="Market:" FontWeight="SemiBold"/>
                    <Run Text="{Binding TotalMarket, StringFormat='${0:N2}', Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Product / lot summary grid. Each product row expands (chevron) to reveal its lots
             underneath as a tree-like sub-list with per-lot Edit / Move / Open / Delete actions. -->
        <DataGrid Grid.Row="2"
                  x:Name="InventoryGrid"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  RowDetailsVisibilityMode="Collapsed"
                  LoadingRow="InventoryGrid_LoadingRow">

            <DataGrid.Columns>
                <!-- Expander chevron. A plain Button + code-behind toggle is used (not a bound
                     ToggleButton) because a DataGrid cell swallows the first click for row
                     selection, which makes ToggleButton two-way binding unreliable. -->
                <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="ToggleLotDetails_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="Show/hide lots">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <materialDesign:PackIcon Width="18" Height="18"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ChevronRight"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Kind" Value="ChevronDown"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Game" Binding="{Binding Game}" Width="90"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                <DataGridTextColumn Header="Set" Binding="{Binding SetCode}" Width="70"/>
                <DataGridTextColumn Header="Owned Qty" Binding="{Binding OwnedQuantity}" Width="90"/>
                <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat={}{0:F2}, TargetNullValue=''}" Width="90"/>
                <DataGridTextColumn Header="Total Cost" Binding="{Binding TotalCost, StringFormat={}{0:F2}}" Width="90"/>
                <DataGridTextColumn Header="Market Value" Binding="{Binding TotalMarket, StringFormat={}{0:F2}}" Width="100"/>
            </DataGrid.Columns>

            <!-- Lot sub-list ("tree" children). Always-present host (RowDetailsVisibilityMode=Visible)
                 whose content is collapsed unless the row is expanded, so it adds no height when closed. -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Margin="48,2,8,8" Padding="8,6"
                            Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Lot column headers -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Qty" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                                <TextBlock Grid.Column="1" Text="Unit Cost" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                                <TextBlock Grid.Column="2" Text="Total" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                                <TextBlock Grid.Column="3" Text="Location" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                                <TextBlock Grid.Column="4" Text="Source" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                                <TextBlock Grid.Column="5" Text="Acquired" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                                <TextBlock Grid.Column="6" Text="Actions" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Lots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Right-click a lot to list it for sale, matching the collection view. -->
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit..."
                                                              Command="{Binding PlacementTarget.DataContext.EditLotCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Move..."
                                                              Command="{Binding PlacementTarget.DataContext.MoveLotCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Open Units..."
                                                              Command="{Binding PlacementTarget.DataContext.OpenUnitsForLotCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="List for Sale..."
                                                              Command="{Binding PlacementTarget.DataContext.ListLotForSaleCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="List on eBay"
                                                              Command="{Binding PlacementTarget.DataContext.ListLotOnEbayCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete"
                                                              Command="{Binding PlacementTarget.DataContext.DeleteLotCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UnitCost, StringFormat='${0:F2}', TargetNullValue='—'}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalCost, StringFormat='${0:F2}'}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- On-market state pill, mirroring the card tile badge: "LISTED"/"PICKED",
                                                     or a distinct blue "eBAY" for eBay listings. Hidden when not for sale. -->
                                                <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        Visibility="{Binding ListingStatus, Converter={conv:NullToCollapsedConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ListingBadge}" Value="eBAY">
                                                                    <Setter Property="Background" Value="#1E88E5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ListingBadge}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding LocationDisplay}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding AcquisitionDate, StringFormat='{}{0:yyyy-MM-dd}'}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Content="Edit" Padding="8,2" Margin="0,0,4,0"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Command="{Binding DataContext.EditLotCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Move" Padding="8,2" Margin="0,0,4,0"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        ToolTip="Change this lot's storage location"
                                                        Command="{Binding DataContext.MoveLotCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Open Units" Padding="8,2" Margin="0,0,4,0"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Command="{Binding DataContext.OpenUnitsForLotCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="List..." Padding="8,2" Margin="0,0,4,0"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        ToolTip="List this lot for sale (Manual / TCGPlayer)"
                                                        Command="{Binding DataContext.ListLotForSaleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="eBay" Padding="8,2" Margin="0,0,4,0"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        ToolTip="List this lot on eBay"
                                                        Command="{Binding DataContext.ListLotOnEbayCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Delete" Padding="8,2"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Command="{Binding DataContext.DeleteLotCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Edit..." Command="{Binding EditProductCommand}"/>
                    <MenuItem Header="Add Lot..." Command="{Binding AddLotCommand}"/>
                    <MenuItem Header="Open Units..." Command="{Binding OpenUnitsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Delete" Command="{Binding DeleteProductCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Empty state -->
        <TextBlock Grid.Row="2"
                   Text="No Inventory Products"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   FontStyle="Italic"
                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
