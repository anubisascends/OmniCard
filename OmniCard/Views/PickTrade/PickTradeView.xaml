<Window x:Class="OmniCard.Views.PickTrade.PickTradeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmniCard.Views.PickTrade"
        xmlns:conv="clr-namespace:OmniCard.Controls.Converters;assembly=OmniCard.Controls"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Link to Trade" Height="500" Width="480"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pick the trade this scan is the replacement for:"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ViewModel.Trades}"
                 SelectedItem="{Binding ViewModel.SelectedTrade}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="56" Height="78" CornerRadius="4"
                                Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                                Margin="0,0,10,0">
                            <Image Source="{Binding ThumbnailPath, Converter={conv:LocalFilePathToImageConverter}}"
                                   Stretch="Uniform"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="Bold"
                                       Text="{Binding Label, Mode=OneWay}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            <ItemsControl ItemsSource="{Binding OutgoingCards}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                                                   FontSize="11">
                                            <Run Text="&#8226; "/><Run Text="{Binding CardName, Mode=OneWay}"/><Run Text="{Binding Foil, Converter={conv:FoilSuffixConverter}, Mode=OneWay}"/><Run Text="{Binding SetCode, Mode=OneWay, StringFormat=' ({0})'}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                            <TextBlock Margin="0,4,0,0" FontSize="11"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}">
                                <Run Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy}', Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding ReplacementCount, Mode=OneWay, StringFormat='{}{0} replacement(s) received'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="No trades recorded yet."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                   Visibility="{Binding ViewModel.Trades.Count, Converter={conv:ZeroToVisibleConverter}}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding ViewModel.CancelCommand}"
                    IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Link" Command="{Binding ViewModel.ConfirmCommand}"
                    IsDefault="True" Padding="16,6" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
