<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OmniCard.DbMigrator</RootNamespace>
    <!-- Table/DB names in the raw SQL come from the EF model and a fixed suffix list, never user
         input, so the interpolated-SQL injection warning doesn't apply. -->
    <NoWarn>$(NoWarn);EF1002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniCard.Shared\OmniCard.Shared.csproj" />
    <ProjectReference Include="..\OmniCard.Data\OmniCard.Data.csproj" />
  </ItemGroup>

</Project>
