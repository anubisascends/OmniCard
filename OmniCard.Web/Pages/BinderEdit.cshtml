@page "/binder/{id:int}/edit"
@model OmniCard.Web.Pages.BinderEditModel
@{
    ViewData["Title"] = Model.Container.Name + " — Edit Binder";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] — OmniCard</title>
    <link rel="stylesheet" href="/css/site.css"/>
</head>
<body class="binder-edit-body">
    <a href="/binder/@Model.Id" class="back-link">&larr; Back to read-only binder</a>

    @if (!Model.EditingEnabled)
    {
        <div class="edit-gate">
            <h1>Binder editing is disabled</h1>
            <p>No editing passphrase is configured on this server. To enable web editing, set
                <code>Binder:EditPassphrase</code> in the shared <code>appsettings.json</code> and restart
                the web companion.</p>
        </div>
    }
    else if (!Model.Unlocked)
    {
        <div class="edit-gate">
            <h1>Edit @Model.Container.Name</h1>
            <p>Editing this binder is passphrase-protected.</p>
            @if (Model.LoginError is not null)
            {
                <p class="edit-error">@Model.LoginError</p>
            }
            <form method="post" class="edit-login">
                @Html.AntiForgeryToken()
                <input type="password" name="passphrase" placeholder="Passphrase" autofocus
                       autocomplete="off" class="edit-login-input"/>
                <button type="submit" class="binder-btn primary">Unlock</button>
            </form>
        </div>
    }
    else
    {
        <div id="binderEdit" class="binder-edit" data-container-id="@Model.Id">
            <!-- Left pane: Unplaced pool -->
            <section class="edit-pane edit-pane-left">
                <h2 class="pane-title">Unplaced Cards</h2>
                <input type="text" id="unplacedFilter" class="edit-filter"
                       placeholder="Filter (Scryfall syntax) — e.g. c:u, r&gt;=rare"/>
                <div id="unplacedPool" class="unplaced-pool" tabindex="0"></div>
                <div id="typeAheadOverlay" class="type-ahead-overlay" hidden>
                    Find: <span id="typeAheadText"></span>
                </div>
            </section>

            <!-- Right pane: spread + controls -->
            <section class="edit-pane edit-pane-right">
                <div class="edit-header">
                    <h2 class="pane-title"><span id="binderTitle">@Model.Container.Name</span></h2>
                    <span id="pageRangeLabel" class="page-range"></span>
                    <span id="totalPagesLabel" class="page-total"></span>
                    <span class="header-spacer"></span>
                    <div class="split-btn">
                        <button type="button" id="addPageDouble" class="binder-btn">+ Add New Page</button>
                        <button type="button" id="addPageMenuBtn" class="binder-btn caret" aria-label="More page options">▾</button>
                        <div id="addPageMenu" class="dropdown-menu" hidden>
                            <button type="button" data-mode="double">Add page (front + back)</button>
                            <button type="button" data-mode="single">Add single-sided page</button>
                        </div>
                    </div>
                    <button type="button" id="insertPageBtn" class="binder-btn">Insert Page…</button>
                </div>

                <div class="edit-layout-controls">
                    <label>Slots per page <input type="number" id="slotsPerPage" min="1" class="num-input"/></label>
                    <label>Columns <input type="number" id="columns" min="1" class="num-input"/></label>
                    <button type="button" id="applyLayout" class="binder-btn">Apply Layout</button>
                </div>

                <div id="spread" class="edit-spread"></div>

                <div class="binder-nav edit-nav">
                    <button type="button" id="binderFirst" class="binder-btn" aria-label="First page">&laquo;</button>
                    <button type="button" id="binderPrev" class="binder-btn" aria-label="Previous">&lsaquo;</button>
                    <div id="spreadTabs" class="spread-tabs"></div>
                    <button type="button" id="binderNext" class="binder-btn" aria-label="Next">&rsaquo;</button>
                    <button type="button" id="binderLast" class="binder-btn" aria-label="Last page">&raquo;</button>
                </div>
                <p class="binder-hint">Drag cards from the pool into a slot, or between slots. Right-click a card for more actions.</p>
            </section>
        </div>

        <!-- Right-click context menu -->
        <div id="cardContextMenu" class="context-menu" hidden>
            <button type="button" data-act="add-missing" class="ctx-slot-only">Add Missing Card…</button>
            <div class="ctx-sep ctx-slot-only"></div>
            <button type="button" data-act="editor">Open Card Editor</button>
            <button type="button" data-act="copy">Copy Card Name(s)</button>
            <div class="ctx-sep"></div>
            <button type="button" data-act="move">Move to Location…</button>
            <button type="button" data-act="unassign" class="ctx-placed-only">Remove from Binder Page</button>
            <button type="button" data-act="tags">Tags…</button>
            <div class="ctx-sep"></div>
            <button type="button" data-act="list">List for Sale…</button>
            <button type="button" data-act="mark-picked">Mark Picked</button>
            <button type="button" data-act="unlist">Unlist</button>
            <div class="ctx-sep"></div>
            <div class="ctx-submenu">
                <span class="ctx-submenu-label">Set Condition ▸</span>
                <div class="ctx-submenu-items">
                    <button type="button" data-act="cond" data-val="NM">NM</button>
                    <button type="button" data-act="cond" data-val="LP">LP</button>
                    <button type="button" data-act="cond" data-val="MP">MP</button>
                    <button type="button" data-act="cond" data-val="HP">HP</button>
                    <button type="button" data-act="cond" data-val="D">D</button>
                </div>
            </div>
            <button type="button" data-act="foil" data-val="true">Set Foil</button>
            <button type="button" data-act="foil" data-val="false">Set Non-Foil</button>
            <div class="ctx-sep"></div>
            <button type="button" data-act="delete" class="ctx-danger">Delete Selected</button>
        </div>

        <!-- Modals -->
        <div id="modalBackdrop" class="edit-modal-backdrop" hidden></div>

        <div id="modalMoveLocation" class="edit-modal" hidden>
            <h3>Move to Location</h3>
            <select id="moveLocationSelect" class="edit-select"></select>
            <label id="moveSectionWrap" hidden>Section <input type="text" id="moveSection" class="edit-input"/></label>
            <div class="edit-modal-actions">
                <button type="button" class="binder-btn" data-close>Cancel</button>
                <button type="button" class="binder-btn primary" id="moveLocationConfirm">Move</button>
            </div>
        </div>

        <div id="modalListSale" class="edit-modal" hidden>
            <h3>List for Sale</h3>
            <label>Channel
                <select id="listChannel" class="edit-select">
                    <option value="TcgPlayer">TCGplayer</option>
                    <option value="Manual">Manual</option>
                </select>
            </label>
            <label>Price <input type="number" step="0.01" min="0" id="listPrice" class="edit-input"/></label>
            <label>Quantity <input type="number" min="1" value="1" id="listQty" class="edit-input"/></label>
            <div class="edit-modal-actions">
                <button type="button" class="binder-btn" data-close>Cancel</button>
                <button type="button" class="binder-btn primary" id="listConfirm">List</button>
            </div>
        </div>

        <div id="modalTags" class="edit-modal" hidden>
            <h3>Tags</h3>
            <div id="tagList" class="tag-edit-list"></div>
            <div class="tag-add-row">
                <input type="text" id="newTagName" class="edit-input" placeholder="New tag…"/>
                <button type="button" class="binder-btn" id="addTagBtn">Add</button>
            </div>
            <div class="edit-modal-actions">
                <button type="button" class="binder-btn primary" data-close>Done</button>
            </div>
        </div>

        <div id="modalEditor" class="edit-modal" hidden>
            <h3 id="editorCardName">Edit Card</h3>
            <label>Condition
                <select id="editorCondition" class="edit-select">
                    <option>NM</option><option>LP</option><option>MP</option><option>HP</option><option>D</option>
                </select>
            </label>
            <label><input type="checkbox" id="editorFoil"/> Foil</label>
            <label id="editorFoilTypeWrap" hidden>Finish <select id="editorFoilType" class="edit-select"></select></label>
            <label>Purchase price <input type="number" step="0.01" min="0" id="editorPrice" class="edit-input"/></label>
            <div class="edit-modal-actions">
                <button type="button" class="binder-btn" data-close>Cancel</button>
                <button type="button" class="binder-btn primary" id="editorSave">Save</button>
            </div>
        </div>

        <div id="modalAddMissing" class="edit-modal wide" hidden>
            <h3>Add Missing Card</h3>
            <div class="add-missing-search">
                <select id="addMissingGame" class="edit-select"></select>
                <input type="text" id="addMissingQuery" class="edit-input" placeholder="Name"/>
                <input type="text" id="addMissingSet" class="edit-input small" placeholder="Set"/>
                <input type="text" id="addMissingCn" class="edit-input small" placeholder="No."/>
                <button type="button" class="binder-btn" id="addMissingSearchBtn">Search</button>
            </div>
            <div id="addMissingResults" class="add-missing-results"></div>
            <div class="add-missing-props">
                <label>Condition
                    <select id="addMissingCondition" class="edit-select">
                        <option>NM</option><option>LP</option><option>MP</option><option>HP</option><option>D</option>
                    </select>
                </label>
                <label><input type="checkbox" id="addMissingFoil"/> Foil</label>
                <label>Price <input type="number" step="0.01" min="0" id="addMissingPrice" class="edit-input small"/></label>
            </div>
            <div class="edit-modal-actions">
                <button type="button" class="binder-btn" data-close>Cancel</button>
                <button type="button" class="binder-btn primary" id="addMissingConfirm" disabled>Add to Slot</button>
            </div>
        </div>

        <div id="modalInsertPage" class="edit-modal" hidden>
            <h3>Insert Page</h3>
            <label>Position <select id="insertPosition" class="edit-select"></select></label>
            <fieldset class="radio-row">
                <label><input type="radio" name="insertSides" value="double" checked/> Front + back (2 pages)</label>
                <label><input type="radio" name="insertSides" value="single"/> Single-sided (1 page)</label>
            </fieldset>
            <div class="edit-modal-actions">
                <button type="button" class="binder-btn" data-close>Cancel</button>
                <button type="button" class="binder-btn primary" id="insertConfirm">Insert</button>
            </div>
        </div>

        <div id="modalMovePage" class="edit-modal" hidden>
            <h3 id="movePageTitle">Move Page</h3>
            <label>Destination <select id="movePosition" class="edit-select"></select></label>
            <div class="edit-modal-actions">
                <button type="button" class="binder-btn" data-close>Cancel</button>
                <button type="button" class="binder-btn primary" id="movePageConfirm">Move</button>
            </div>
        </div>

        <div id="modalShiftPage" class="edit-modal" hidden>
            <h3 id="shiftPageTitle">Shift Cards</h3>
            <p class="binder-hint">Move cards to fix an off-by-a-page data-entry mistake. Each card keeps its slot within the page; cards in the Unplaced pool aren't touched.</p>
            <label>Direction
                <select id="shiftDirection" class="edit-select">
                    <option value="left">Toward the front (left / lower page numbers)</option>
                    <option value="right">Toward the back (right / higher page numbers)</option>
                </select>
            </label>
            <fieldset class="radio-row">
                <label><input type="radio" name="shiftScope" value="OnlyThisPage"/> Only this page</label>
                <label><input type="radio" name="shiftScope" value="ThisAndBefore"/> This page and all pages before it</label>
                <label><input type="radio" name="shiftScope" value="ThisAndAfter" checked/> This page and all pages after it</label>
            </fieldset>
            <label>Pages to shift <input type="number" id="shiftCount" class="edit-input" min="1" value="1"/></label>
            <div class="edit-modal-actions">
                <button type="button" class="binder-btn" data-close>Cancel</button>
                <button type="button" class="binder-btn primary" id="shiftConfirm">Shift</button>
            </div>
        </div>

        <div id="toast" class="edit-toast" hidden></div>

        <script id="binder-state" type="application/json">@Html.Raw(Model.StateJson)</script>
        <script id="binder-unplaced" type="application/json">@Html.Raw(Model.UnplacedJson)</script>
        <script id="binder-games" type="application/json">@Html.Raw(Model.GamesJson)</script>
        <script src="/js/binder-edit.js"></script>
    }
</body>
</html>
