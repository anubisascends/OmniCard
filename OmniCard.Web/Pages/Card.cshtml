@page "/card/{id:int}"
@model OmniCard.Web.Pages.CardModel
@{
    ViewData["Title"] = Model.Card.Name;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] — OmniCard</title>
    <link rel="stylesheet" href="/css/site.css"/>
</head>
<body>
    @if (Model.Card.ContainerId.HasValue)
    {
        <a href="/location/@Model.Card.ContainerId" class="back-link">&larr; Back to @(Model.Card.Container?.Name ?? "Location")</a>
    }
    else
    {
        <a href="/" class="back-link">&larr; Home</a>
    }

    <header>
        <h1>@Model.Card.Name</h1>
        @if (Model.Card.IsTraded)
        {
            <p><span class="badge trade-badge">TRADED</span></p>
        }
    </header>

    <main>
        @if (Model.TradeMessage is not null)
        {
            <p class="badge trade-badge">@Model.TradeMessage</p>
        }

        <div class="card-image-wrap">
            @if (Model.ImageUrl is not null)
            {
                <img src="@Model.ImageUrl" alt="@Model.Card.Name" class="card-image"/>
            }
            @if (Model.Card.MarketPrice > 0m)
            {
                <span class="price-badge">@Model.Card.MarketPrice.ToString("C")</span>
            }
        </div>

        <p class="card-actions">
            @if (!Model.Card.IsTraded)
            {
                <form method="post" asp-page="/TradeSession" asp-page-handler="AddCard" style="display:inline">
                    <input type="hidden" name="lotId" value="@Model.Card.Id"/>
                    <button type="submit" class="trade-button">
                        @(Model.ActiveTradeSessionId is null ? "Trade this card…" : "Add to trade session…")
                    </button>
                </form>
                @if (Model.ActiveTradeSessionId is { } sessionId)
                {
                    <a href="/trade/session/@sessionId" class="tcg-link">Open trade session &rarr;</a>
                }
            }
            <a href="@Model.TcgPlayerUrl" class="tcg-link" target="_blank" rel="noopener">View on TCGPlayer &rarr;</a>
        </p>
        @if (Model.TradeMessage is not null)
        {
            <p class="trade-confirm">@Model.TradeMessage</p>
        }

        <table class="detail-table">
            <tr><th>Set</th><td>@Model.Card.SetName (@Model.Card.SetCode)</td></tr>
            <tr><th>Collector #</th><td>@Model.Card.Number</td></tr>
            <tr><th>Rarity</th><td>@Model.Card.Rarity</td></tr>
            <tr><th>Color</th><td>@(Model.Card.Color ?? "—")</td></tr>
            <tr><th>Type</th><td>@(Model.Card.CardType ?? "—")</td></tr>
            <tr><th>Foil</th><td>@(Model.Card.IsFoil ? (string.IsNullOrEmpty(Model.Card.FoilType) ? "Yes" : $"Yes — {Model.Card.FoilType}") : "No")</td></tr>
            <tr><th>Condition</th><td>@Model.Card.Condition</td></tr>
            <tr><th>Purchase Price</th><td>@(Model.Card.PurchasePrice.HasValue ? Model.Card.PurchasePrice.Value.ToString("C") : "—")</td></tr>
            <tr><th>Market Price</th><td>@(Model.Card.MarketPrice > 0m ? Model.Card.MarketPrice.ToString("C") : "—")</td></tr>
            <tr><th>Date Added</th><td>@Model.Card.DateAdded.ToString("yyyy-MM-dd")</td></tr>
            @if (Model.Card.Container is not null)
            {
                <tr><th>Location</th><td>@Model.Card.Container.Name</td></tr>
            }
            @if (Model.Card.Page.HasValue)
            {
                <tr><th>Page</th><td>@Model.Card.Page</td></tr>
            }
            @if (Model.Card.Slot.HasValue)
            {
                <tr><th>Slot</th><td>@Model.Card.Slot</td></tr>
            }
            @if (Model.Card.Section is not null)
            {
                <tr><th>Section</th><td>@Model.Card.Section</td></tr>
            }
            @if (Model.Card.Tags.Count > 0)
            {
                <tr>
                    <th>Tags</th>
                    <td>
                        <div class="tag-list">
                            @foreach (var t in Model.Card.Tags)
                            {
                                <span class="tag-chip">@t</span>
                            }
                        </div>
                    </td>
                </tr>
            }
            @foreach (var kv in ExtendedDataParser.Parse(Model.ExtendedDataJson))
            {
                <tr><th>@kv.Key</th><td>@kv.Value</td></tr>
            }
        </table>
    </main>
</body>
</html>
