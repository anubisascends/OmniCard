@page "/trade/session/{id:guid?}"
@model OmniCard.Web.Pages.TradeSessionModel
@{
    ViewData["Title"] = "Trade";
    var record = Model.Record;
    var id = Model.SessionId;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] — OmniCard</title>
    <link rel="stylesheet" href="/css/site.css"/>
</head>
<body>
    <a href="/" class="back-link">&larr; Back to collection</a>

    <header>
        <h1>Trade</h1>
    </header>

    <main class="trade-session">
    @if (record is null || id is null)
    {
        <p class="empty">This trade session is no longer available.</p>
        <p><a href="/trade/session" class="trade-button">Start a new trade</a></p>
    }
    else
    {
        <h2>Cards you're giving (@record.OutgoingItems.Count)</h2>
        @if (record.OutgoingItems.Count == 0)
        {
            <p class="muted">No cards added yet. Add owned cards below, or browse to any card and tap
               <em>Add to trade session</em>.</p>
        }
        else
        {
            <ul class="trade-items">
            @for (var i = 0; i < record.OutgoingItems.Count; i++)
            {
                var item = record.OutgoingItems[i];
                string? tcgUrl = item.LotId is int lid && Model.TcgPlayerUrlByLotId.TryGetValue(lid, out var u) ? u : null;
                <li>
                    <span class="grow">
                        @if (tcgUrl is not null)
                        {
                            <a href="@tcgUrl" target="_blank" rel="noopener" title="View on TCGPlayer"><strong>@item.CardName</strong></a>
                        }
                        else
                        {
                            <strong>@item.CardName</strong>
                        }@(item.Foil ? " (Foil)" : "")
                        @if (!string.IsNullOrEmpty(item.SetCode)) { <span class="muted">@item.SetCode</span> }
                        @if (item.IsOffDatabase) { <span class="muted">· off-database 📷</span> }
                        <br/>
                        <span class="muted">@(item.EstimatedValue is { } v ? v.ToString("C") : "no value")</span>
                        @if (tcgUrl is not null)
                        {
                            <a href="@tcgUrl" target="_blank" rel="noopener" class="muted tcg-inline">· TCGPlayer &rarr;</a>
                        }
                    </span>
                    <form method="post" asp-page-handler="RemoveItem" asp-route-id="@id" style="display:inline">
                        <input type="hidden" name="index" value="@i"/>
                        <button type="submit" class="btn-small">Remove</button>
                    </form>
                </li>
            }
            </ul>
        }
        <div class="trade-total">Total given: @Model.OutgoingTotal.ToString("C")</div>

        <!-- Add an owned card -->
        <div class="trade-section">
            <h2>Add an owned card</h2>
            <form method="get" asp-route-id="@id" class="trade-search">
                <input type="search" name="Q" value="@Model.Q" placeholder="Search your collection (name, set:XYZ, cn:123)"/>
                <button type="submit">Search</button>
            </form>
            @if (Model.SearchResults.Count > 0)
            {
                foreach (var r in Model.SearchResults)
                {
                    <div class="owned-result">
                        @if (r.ImageUrl is not null)
                        {
                            <img src="@r.ImageUrl" alt="@r.Name" class="trade-thumb"/>
                        }
                        <span class="grow">
                            <strong>@r.Name</strong>@(r.IsFoil ? " (Foil)" : "")
                            <br/>
                            <span class="muted">@r.SetName (@r.SetCode) #@r.Number · @r.Condition
                                @if (r.MarketPrice is { } mp) { <text>· @mp.ToString("C")</text> }
                            </span>
                        </span>
                        <form method="post" asp-page-handler="AddOwned" asp-route-id="@id" style="display:inline">
                            <input type="hidden" name="lotId" value="@r.LotId"/>
                            <input type="hidden" name="Q" value="@Model.Q"/>
                            <button type="submit" class="btn-small">Add</button>
                        </form>
                    </div>
                }
            }
            else if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <p class="muted">No matching owned cards.</p>
            }
        </div>

        <!-- Add an off-database card -->
        <div class="trade-section">
            <h2>Add an off-database card</h2>
            <p class="muted">A card that isn't in your collection (a card-show pickup). Photo required;
               name and value are optional.</p>
            <form method="post" asp-page-handler="AddOffDb" asp-route-id="@id" enctype="multipart/form-data">
                <div class="trade-field-row">
                    <div>
                        <label for="offName">Card name</label>
                        <input type="text" id="offName" name="name" placeholder="optional"/>
                    </div>
                    <div>
                        <label for="offValue">Est. value</label>
                        <input type="number" step="0.01" min="0" id="offValue" name="value" placeholder="optional"/>
                    </div>
                </div>
                <div>
                    <label for="offPhoto">Photo of the card</label>
                    <input type="file" id="offPhoto" name="photo" accept="image/*" capture="environment"/>
                </div>
                <button type="submit">Add off-database card</button>
            </form>
        </div>

        <!-- Finalize -->
        <div class="trade-section">
            <h2>Finalize trade</h2>
            <form method="post" asp-page-handler="Finalize" asp-route-id="@id" enctype="multipart/form-data">
                <div>
                    <label for="note">Note (what you received / who with)</label>
                    <textarea id="note" name="note" placeholder="e.g. 2x Fire Lotus, traded with Dave"></textarea>
                </div>
                <div>
                    <label for="receivedValue">Est. value of cards received</label>
                    <input type="number" step="0.01" min="0" id="receivedValue" name="receivedValue" placeholder="optional"/>
                </div>
                <div>
                    <label for="receivedPhoto">Photo of the cards you received</label>
                    <input type="file" id="receivedPhoto" name="receivedPhoto" accept="image/*" capture="environment"/>
                </div>
                <button type="submit">Finalize trade</button>
            </form>
        </div>

        <!-- Cancel -->
        <div class="trade-section">
            <form method="post" asp-page-handler="Cancel" asp-route-id="@id"
                  onsubmit="return confirm('Cancel this trade? All cards added to it will be discarded.');">
                <button type="submit" class="btn-cancel">Cancel trade</button>
            </form>
        </div>
    }
    </main>
</body>
</html>
