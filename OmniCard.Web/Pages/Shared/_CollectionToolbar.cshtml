@* Quick-search + sort controls for the card-tile collection views. Behaviour lives in
   /js/collection-view.js, which finds this toolbar and the sibling .card-tiles grid. *@
<div class="collection-toolbar">
    <input type="search" class="cv-filter" placeholder="Quick search name, set, or collector #…"
           aria-label="Quick search shown cards" autocomplete="off" />
    <label class="cv-sort-label">
        <span>Sort</span>
        <select class="cv-sort" aria-label="Sort by">
            <option value="name">Name</option>
            <option value="price">Market Price</option>
            <option value="condition">Condition</option>
            <option value="foil">Foil</option>
            <option value="set">Set</option>
            <option value="cn">Collector #</option>
        </select>
    </label>
    <button type="button" class="cv-dir" aria-label="Toggle sort direction">↑ Asc</button>
    <span class="cv-count" aria-live="polite"></span>
</div>
