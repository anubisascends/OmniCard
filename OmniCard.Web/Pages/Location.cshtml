@page "/location/{id:int}"
@model OmniCard.Web.Pages.LocationModel
@{
    ViewData["Title"] = Model.Container.Name;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] — OmniCard</title>
    <link rel="stylesheet" href="/css/site.css"/>
</head>
<body>
    <a href="/" class="back-link">&larr; All Locations</a>
    <header>
        <h1>@Model.Container.Name</h1>
        <p><span class="badge">@Model.TypeDisplay</span> &middot; @Model.CardCount card(s)</p>
    </header>
    <main>
        @if (Model.Container.ContainerType == ContainerType.Binder)
        {
            <a href="/binder/@Model.Container.Id" class="binder-open">📖 Open binder view</a>
            <a href="/binder/@Model.Container.Id/edit" class="binder-open">✏️ Edit binder</a>
        }

        @if (Model.Sets.Count > 0)
        {
            <h2>Sets</h2>
            <ul class="set-list">
                @foreach (var s in Model.Sets)
                {
                    <li>@s.SetName (@s.SetCode) <span class="count">&times;@s.Count</span></li>
                }
            </ul>
        }

        <h2>Cards</h2>
        @if (Model.Cards.Count == 0)
        {
            <p class="empty">No cards in this location.</p>
        }
        else if (Model.IsDeckBox && Model.Groups.Count > 0)
        {
            <div class="deck-group-bar">
                <span>Group by:</span>
                <a class="@(Model.GroupMode == "none" ? "active" : "")" href="/location/@Model.Container.Id">None</a>
                <a class="@(Model.GroupMode == "type" ? "active" : "")" href="/location/@Model.Container.Id?group=type">Type</a>
                <a class="@(Model.GroupMode == "mv" ? "active" : "")" href="/location/@Model.Container.Id?group=mv">Mana Value</a>
            </div>
            <div class="deck-groups">
                @foreach (var col in Model.Groups)
                {
                    <div class="deck-column">
                        <div class="deck-col-header">@col.Header <span class="count">&times;@col.Count</span></div>
                        <div class="deck-stack">
                            @foreach (var card in col.Cards)
                            {
                                <a href="/card/@card.Id" class="stack-card" title="@card.Name (@card.SetCode) — @card.Condition@(card.IsFoil ? " · Foil" : "")">
                                    @if (card.ImageUrl is not null)
                                    {
                                        <img src="@card.ImageUrl" loading="lazy" alt="@card.Name"/>
                                    }
                                    else
                                    {
                                        <div class="no-image">@card.Name</div>
                                    }
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @if (Model.IsDeckBox)
            {
                <div class="deck-group-bar">
                    <span>Group by:</span>
                    <a class="@(Model.GroupMode == "none" ? "active" : "")" href="/location/@Model.Container.Id">None</a>
                    <a class="@(Model.GroupMode == "type" ? "active" : "")" href="/location/@Model.Container.Id?group=type">Type</a>
                    <a class="@(Model.GroupMode == "mv" ? "active" : "")" href="/location/@Model.Container.Id?group=mv">Mana Value</a>
                </div>
            }
            <partial name="_CollectionToolbar" />
            <div class="card-tiles">
                @foreach (var card in Model.Cards)
                {
                    <a href="/card/@card.Id" class="card-tile"
                       data-name="@card.Name"
                       data-set="@card.SetCode"
                       data-setname="@card.SetName"
                       data-cn="@card.Number"
                       data-price="@(card.MarketPrice.HasValue ? card.MarketPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                       data-cond="@card.Condition"
                       data-foil="@(card.IsFoil ? "1" : "0")">
                        @if (card.ImageUrl is not null)
                        {
                            <img src="@card.ImageUrl" loading="lazy" alt="@card.Name"/>
                        }
                        else
                        {
                            <div class="no-image">No Image</div>
                        }
                        @if (card.MarketPrice is not null)
                        {
                            <span class="price-badge">@card.MarketPrice.Value.ToString("C")</span>
                        }
                        <div class="name" title="@card.Name">@card.Name</div>
                        <div class="set">@card.SetName (@card.SetCode)</div>
                        @if (card.Quantity > 1)
                        {
                            <div class="qty">&times;@card.Quantity</div>
                        }
                        @if (card.Tags.Count > 0)
                        {
                            <div class="tag-list">
                                @foreach (var t in card.Tags)
                                {
                                    <span class="tag-chip">@t</span>
                                }
                            </div>
                        }
                    </a>
                }
            </div>
        }
    </main>
    <script src="/js/collection-view.js"></script>
</body>
</html>
