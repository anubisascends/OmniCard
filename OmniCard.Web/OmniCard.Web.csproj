<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep the publish output lean. Native runtime packages (SkiaSharp + HarfBuzz, pulled in by
         QuestPDF) ship large debug-symbol files — libSkiaSharp.pdb alone is ~89 MB, ~110 MB per RID —
         plus XML docs, none of which are used at runtime. Excluding them here trims hundreds of MB
         from a publish. Always publish with an explicit RID (see OmniCard.Web/README.md ▸ Publish);
         a RID-less framework-dependent publish otherwise copies every platform's native assets. -->
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
  </PropertyGroup>

  <!-- Strip native debug symbols from the publish output. The property above doesn't catch these
       (libSkiaSharp.pdb ~89 MB, libHarfBuzzSharp.pdb ~23 MB): with an explicit RID they land at the
       publish root, and with a RID-less publish they sit under runtimes/**. We match native symbols
       (lib*.pdb) plus everything under runtimes/, and deliberately keep the small OmniCard.*.pdb
       managed symbols for readable stack traces. -->
  <Target Name="StripNativePdbsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedNativePdb Include="$(PublishDir)**\lib*.pdb;$(PublishDir)runtimes\**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedNativePdb)" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniCard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Pin Microsoft.OpenApi above the transitive 2.0.0 pulled in by Microsoft.AspNetCore.OpenApi:
         2.0.0 has a known high-severity DoS (CVE-2026-49451 / GHSA-v5pm-xwqc-g5wc — stack overflow
         on circular schema refs), fixed in 2.7.5. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The React app lives under ClientApp/ and is built by Vite into wwwroot/app (npm run build).
       Keep its source + node_modules out of the .NET compile/content globs so they never end up in
       a publish. The built static output under wwwroot/app IS published (default wwwroot behavior). -->
  <ItemGroup>
    <Compile Remove="ClientApp\**" />
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
    <EmbeddedResource Remove="ClientApp\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniCard.Shared\OmniCard.Shared.csproj" />
    <ProjectReference Include="..\OmniCard.Data\OmniCard.Data.csproj" />
    <ProjectReference Include="..\OmniCard.Collection\OmniCard.Collection.csproj" />
    <ProjectReference Include="..\OmniCard.CardMatching\OmniCard.CardMatching.csproj" />
    <ProjectReference Include="..\OmniCard.Audit\OmniCard.Audit.csproj" />
    <ProjectReference Include="..\OmniCard.eBay\OmniCard.eBay.csproj" />
    <ProjectReference Include="..\OmniCard.Api.Contracts\OmniCard.Api.Contracts.csproj" />
  </ItemGroup>

</Project>
